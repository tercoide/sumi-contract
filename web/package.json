{
  "name": "sumi-contract",
  "version": "0.1.0",
  "description": "The paperwork of a building work: prices, budget, Gantt, contracts (web version)",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "i18n": "node scripts/i18n.mjs",
    "build": "node scripts/i18n.mjs && tsc && tsc -p client && vite build",
    "test": "node scripts/i18n.mjs && tsc && tsc -p client && node --test --enable-source-maps \"dist/test/**/*.test.js\"",
    "start": "npm run build && node --enable-source-maps dist/src/server/main.js",
    "dev": "tsc && (node --enable-source-maps dist/src/server/main.js & vite)",
    "gui-test": "node scripts/gui-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
