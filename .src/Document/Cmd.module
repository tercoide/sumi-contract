' Gambas module file

'' The commands: the one way to change a project. The screens, the AI and imports all call Run, so the AI can
'' do whatever a person can, and every change is written to the project's change log (Project.Changes): who,
'' when, how (Who.Via), the command and its arguments, and the touched things before and after.
''
'' Run(command, args) returns a Collection: {"ok": True, ...results} or {"error": "why"}. Arguments and
'' results are JSON-like (strings, numbers, booleans, Collections, arrays), so they go to the AI as they are.
'' Things are named by Id or by code ("key").
''
'' Undo puts back the before of the caller's last change (a whole group: an AI script, an import), as a new
'' "undo" entry: the log only grows. Redo undoes that undo. A change made later by someone else to the same
'' thing blocks the undo (it would erase their work).
''
'' Commands (see Help): info, log, undo, redo, project.set, book.set, rubro.set, rubro.delete, charge.add,
'' charge.set, charge.delete, resource.list, resource.get, resource.add, resource.set, resource.delete,
'' analysis.list, analysis.get, analysis.add, analysis.set, analysis.copy, analysis.delete, analysis.addline,
'' analysis.setline, analysis.removeline, analysis.flatten, prices.import, budget.list, item.add, item.set,
'' item.delete, item.move, rubro.coefs, schedule.get, task.set, contractor.*, standard.export, prices.fromStandard,
'' contract.*, part.*, cert.*, payment.*

Public Const ABSENT As String = "~absent~"      '' a snapshot of something that didn't exist
Public Const COALESCE_SECONDS As Integer = 120  '' edits of the same field in a row become one change

Private $hChange As Change                      ' the change being made
Private $sGroup As String                       ' the group of BeginGroup
Private $iDepth As Integer                      ' commands called by commands are part of the outer one

'' THE ENTRY POINT

Public Function Run(sCommand As String, Optional cArgs As Collection) As Collection

    Dim cOut As Collection

    If Not cArgs Then cArgs = New Collection
    If Not sumi.Project Then Return Fail(("There is no project open."))
    Inc $iDepth
    Try cOut = Dispatch(LCase(sCommand), cArgs)
    If Error Then
        cOut = Fail(Error.Text & " (" & Error.Where & ")")
        AppLog.Error("Cmd " & sCommand & ": " & Error.Text & " " & Error.Where, "Cmd.Run")
    Endif
    Dec $iDepth
    If cOut.Exist("error") Then
        $hChange = Null
    Else If $hChange And If $iDepth = 0 Then
        Finish()
    Endif
    Return cOut

End

'' The changes until EndGroup are one action (undone together)
Public Sub BeginGroup()

    $sGroup = Ids.Make("g")

End

Public Sub EndGroup()

    $sGroup = ""

End

Private Function Dispatch(sCommand As String, c As Collection) As Collection

    Select Case sCommand
        Case "info"
            Return Info()
        Case "help"
            Return Ok(["commands": Help()])
        Case "log"
            Return LogList(c)
        Case "undo"
            Return Undo(False)
        Case "redo"
            Return Undo(True)
        Case "project.set"
            Return ProjectSet(c)
        Case "book.set"
            Return BookSet(c)
        Case "rubro.set"
            Return RubroSet(c)
        Case "rubro.delete"
            Return RubroDelete(c)
        Case "charge.add", "charge.set", "charge.delete"
            Return ChargeCmd(sCommand, c)
        Case "resource.list"
            Return ResourceList(c)
        Case "resource.get"
            Return ResourceGet(c)
        Case "resource.add"
            Return ResourceAdd(c)
        Case "resource.set"
            Return ResourceSet(c)
        Case "resource.delete"
            Return ResourceDelete(c)
        Case "analysis.list"
            Return AnalysisList(c)
        Case "analysis.get"
            Return AnalysisGet(c)
        Case "analysis.add"
            Return AnalysisAdd(c)
        Case "analysis.set"
            Return AnalysisSet(c)
        Case "analysis.copy"
            Return AnalysisCopy(c)
        Case "analysis.delete"
            Return AnalysisDelete(c)
        Case "analysis.addline", "analysis.setline", "analysis.removeline"
            Return LineCmd(sCommand, c)
        Case "analysis.flatten"
            Return AnalysisFlatten(c)
        Case "prices.import"
            Return PricesImport(c)
        Case "budget.list"
            Return BudgetList(c)
        Case "item.add"
            Return ItemAdd(c)
        Case "item.set"
            Return ItemSet(c)
        Case "item.delete"
            Return ItemDelete(c)
        Case "item.move"
            Return ItemMove(c)
        Case "rubro.coefs"
            Return RubroCoefs(c)
        Case "contractor.list", "contractor.get", "contractor.add", "contractor.set", "contractor.delete"
            Return ContractorCmd(sCommand, c)
        Case "standard.export"
            Return StandardExport(c)
        Case "prices.fromstandard"
            Return PricesFromStandard(c)
        Case "contract.list", "contract.get", "contract.add", "contract.set", "contract.delete"
            Return ContractCmd(sCommand, c)
        Case "part.add", "part.set", "part.remove"
            Return PartCmd(sCommand, c)
        Case "cert.add", "cert.set", "cert.delete"
            Return CertCmd(sCommand, c)
        Case "payment.add", "payment.set", "payment.delete"
            Return PaymentCmd(sCommand, c)
        Case "report.pdf"
            Return ReportPdf(c)
        Case "design.rows", "design.sync", "design.map"
            Return DesignCmd(sCommand, c)
        Case "schedule.get"
            Return ScheduleGet(c)
        Case "task.set"
            Return TaskSet(c)
    End Select
    Return Fail(Subst(("Unknown command &1."), sCommand))

End

'' What each command takes, for the AI and the help
Public Function Help() As Collection

    Dim c As New Collection

    c["info"] = "{} -> the project, its counts and who you are"
    c["log"] = "{limit?, who?, target?} -> the last changes"
    c["undo"] = "{} -> undoes your last action"
    c["redo"] = "{} -> redoes what you undid last"
    c["project.set"] = "{field: value...} the Project tab's fields, as in the file: name, code, workType, use, location, city, province, parcel, plotArea, coveredArea, semiCoveredArea, floors, client, clientTaxId, clientPhone, clientEmail, startDate (yyyy-mm-dd), durationDays, workDaysPerWeek, hoursPerDay, holidays [yyyy-mm-dd...], currency, overheadPct, profitPct, taxesPct, contractMode, advancePct, retentionPct, certificatePeriod, adjustmentIndex, adjustmentBase, guaranteeDays, professionals [{role, name, registration, phone, email}...], notes, designFile"
    c["book.set"] = "{updateCoef?, freightPerKm?} the price book's coefficients"
    c["rubro.set"] = "{number, name}"
    c["rubro.delete"] = "{number}"
    c["charge.add"] = "{name, pct?, amount?, hours?} a labor charge: % of the wage, or an amount over some hours"
    c["charge.set"] = "{index, name?, pct?, amount?, hours?}"
    c["charge.delete"] = "{index}"
    c["resource.list"] = "{kind?, text?, limit?} -> resources with their unit price"
    c["resource.get"] = "{key} -> a resource (key = id or code), its prices and the analyses using it"
    c["resource.add"] = "{kind, name, unit, code?, price?, wage?, machine?, loss?, origin?, distance?, truckLoad?, source?} -> its id and code"
    c["resource.set"] = "{key, field: value...} fields: code, name, unit, kind, price, override, wage, loss, origin, distance, truckLoad, updated, source, machine (null removes it), machine.<power|cost|residualPct|lifeHours|hoursPerYear|interestPct|repairsPct|fuel|fuelPrice|fuelUse|lubricantPct>"
    c["resource.delete"] = "{key, force?} refused while analyses use it, unless force"
    c["analysis.list"] = "{rubro?, text?, limit?} -> analyses with their direct cost and price"
    c["analysis.get"] = "{key} -> an analysis with its lines, parts A/B/C, direct cost, price and problems"
    c["analysis.add"] = "{name, unit, rubro?, code?, laborYield?, equipmentYield?, note?, lines? [{resource|analysis: key, qty}...]} -> its id and code"
    c["analysis.set"] = "{key, field: value...} fields: code, name, unit, rubro, laborYield, equipmentYield, note"
    c["analysis.copy"] = "{key, code?, name?} -> the new id and code"
    c["analysis.delete"] = "{key, force?} refused while other analyses use it, unless force"
    c["analysis.addline"] = "{key, resource|analysis: key, qty}"
    c["analysis.setline"] = "{key, index, qty}"
    c["analysis.removeline"] = "{key, index}"
    c["analysis.flatten"] = "{key} sub-analyses become their resources (the link is lost)"
    c["prices.import"] = "{folder, added?} imports a CSV library (Tincho's licita2003 format)"
    c["budget.list"] = "{rubro?} -> the budget: items (code, description, unit, qty, unit direct cost, unit price, total, problem) and totals by rubro and overall"
    c["item.add"] = "{analysis: key | description + unitCost (a manual item), qty?, rubro? (default: the analysis's), unit?, note?} -> its id and code"
    c["item.set"] = "{key (id or code like 3.02), field: value...} fields: qty, description, unit, unitCost, rubro, analysis, note, coefs [{name, pct}...] (the item's own coefficients), qtySource, designQty, designRef"
    c["item.delete"] = "{key}"
    c["item.move"] = "{key, by} moves an item up (by < 0) or down within its rubro"
    c["schedule.get"] = "{curve?} -> the Gantt: for each item its task (days, crew, after, lag, earlyStart, earlyFinish, slack, critical, start and end dates), the length in working days, the end date, and with curve the money spent each month"
    c["task.set"] = "{key (budget item id or code), days?, crew?, after? [item keys it waits for], lag?, startNotBefore?, done? (0 to 1), suggest? (true: days from the labor hours and the crew)}"
    c["contractor.list"] = "{text?, trade?} -> the company's contractors (shared by all projects), with their documents due"
    c["contractor.get"] = "{key (id or name)}"
    c["contractor.add"] = "{name, trade?, taxId?, contact?, phone?, email?, address?, bank?, note?, docs? [{kind, number, expires (yyyy-mm-dd), file, note}...]} -> its id"
    c["contractor.set"] = "{key, field: value...} the same fields (docs replaces the list)"
    c["contractor.delete"] = "{key} refused while a contract of the open project uses it"
    c["standard.export"] = "{} the project's prices (resources, analyses, rubros, labor charges) go to the company's standard library: new ones added, the same ones (by id) replaced"
    c["prices.fromStandard"] = "{} the project takes the standard library's prices: new resources and analyses added, the same ones replaced"
    c["contract.list"] = "{} -> the project's contracts with their contractor, amount, progress and balance"
    c["contract.get"] = "{key (id or code C-01)} -> a contract: parts (item, qty, % of the item, agreed price, measured), certificates with their amounts [work, adjustment, advance recovered, retention, net] and payments"
    c["contract.add"] = "{contractor (key), title?, code?, mode?, advancePct?, retentionPct?, period?, indexName?, baseIndex?, baseMonth?, signed?, note?} conditions default to the Project tab's -> its id and code"
    c["contract.set"] = "{key, field: value...} the same fields"
    c["contract.delete"] = "{key}"
    c["part.add"] = "{contract, item (budget item key), qty? | pct? (of the item; default: what no contract takes yet), unitPrice? (default: the budget's unit price)}"
    c["part.set"] = "{contract, part (part id or item key), qty? | pct?, unitPrice?}"
    c["part.remove"] = "{contract, part}"
    c["cert.add"] = "{contract, kind? (advance, progress, retention; default progress), period? (yyyy-mm), date?, index?} -> its number"
    c["cert.set"] = "{contract, cert (number), period?, date?, index?, status? (draft, issued), note?, measures? [{part (part id or item key), acc? (accumulated quantity) | pct? (accumulated % of the part)}...]}"
    c["cert.delete"] = "{contract, cert}"
    c["payment.add"] = "{contract, amount, date?, means? (transfer, cheque, cash, other), reference?, certificate? (number), invoice?, invoiceDate?, note?} -> its index"
    c["payment.set"] = "{contract, index, field: value...}"
    c["payment.delete"] = "{contract, index}"
    c["design.rows"] = "{} -> the quantities of the sumi-designer file (Project tab), each row with its key and its analyses (and whether they come from the designer)"
    c["design.sync"] = "{} creates and updates the budget items from the design's quantities and the analyses of each row"
    c["design.map"] = "{key (a row's key), analyses [{code, factor}...]} the analyses of a design row in this project, while sumi-designer has none for it"
    c["report.pdf"] = "{kind (budget, summary, analyses, gantt, certificate), file (the .pdf to write), contract? and cert? (for a certificate)} writes a PDF report"
    c["rubro.coefs"] = "{rubro, coefs [{name, pct}...]} the coefficients of a rubro in the budget (on top of the project's)"
    Return c

End

'' RESULTS

Public Function Ok(Optional c As Collection) As Collection

    If Not c Then c = New Collection
    c["ok"] = True
    Return c

End

Public Function Fail(sWhy As String) As Collection

    Return ["error": sWhy]

End

'' THE LOG

'' A change starts: who, the command, the arguments, the summary
Private Sub Start(sCommand As String, cArgs As Collection, sSummary As String)

    If $hChange Then                ' a command inside another one: it is part of it
        If sSummary Then $hChange.Summary &= "; " & sSummary
        Return
    Endif
    $hChange = New Change
    $hChange.Who = Who.Name()
    $hChange.UserId = Who.UserId()
    $hChange.Via = Who.Via
    $hChange.Model = Who.Model
    $hChange.Command = sCommand
    $hChange.Params = cArgs
    $hChange.Summary = sSummary
    $hChange.Group = $sGroup

End

'' sTarget is about to change: its before is kept (once)
Private Sub Touch(sTarget As String)

    If Not $hChange Then Return
    If $hChange.Targets.Exist(sTarget) Then Return
    $hChange.Targets.Add(sTarget)
    $hChange.Before[sTarget] = Snapshot(sTarget)

End

Private Sub Finish()

    Dim h As Change = $hChange
    Dim sTarget As String
    Dim hLast As Change

    $hChange = Null
    For Each sTarget In h.Targets
        If sTarget <> "prices" Then h.After[sTarget] = Snapshot(sTarget)
    Next

    ' the company's data has its own log
    If IsCompany(h) Then
        Company.Changes.Add(h)
        Company.Save()
        If sumi.Interactive Then fMain.DataChanged()
        Return
    Endif

    ' the same field edited again (typing in a box): one change
    If sumi.Project.Changes.Count Then
        hLast = sumi.Project.Changes[sumi.Project.Changes.Max]
        If CanCoalesce(hLast, h) Then
            hLast.After = h.After
            hLast.Params = h.Params
            hLast.Summary = h.Summary
            hLast.When = h.When
            sumi.Changed()
            Return
        Endif
    Endif

    sumi.Project.Changes.Add(h)
    sumi.Changed()

End

'' Does a change touch only the company's data (contractors, the standard library)?
Public Function IsCompany(h As Change) As Boolean

    Dim sTarget As String

    If h.Targets.Count = 0 Then Return False
    For Each sTarget In h.Targets
        If Not (sTarget Begins "contractor:") And If sTarget <> "standard" Then Return False
    Next
    Return True

End

Private Function CanCoalesce(hLast As Change, h As Change) As Boolean

    Dim sKey As String

    If Not (h.Command Like "*.set*") Then Return False
    If hLast.Command <> h.Command Or If hLast.UserId <> h.UserId Or If hLast.Via <> h.Via Then Return False
    If hLast.UndoneBy Or If hLast.UndoOf Or If h.Group Or If hLast.Group Then Return False
    If hLast.Targets.Join() <> h.Targets.Join() Then Return False
    If DateDiff(Project.ReadDate(hLast.When, Now), Project.ReadDate(h.When, Now), gb.Second) > COALESCE_SECONDS Then Return False
    ' the same fields
    If hLast.Params.Count <> h.Params.Count Then Return False
    For Each sKey In KeysOf(h.Params)
        If Not hLast.Params.Exist(sKey) Then Return False
    Next
    If h.Params.Exist("index") And If hLast.Params["index"] <> h.Params["index"] Then Return False
    Return True

End

Private Function KeysOf(c As Collection) As String[]

    Dim a As New String[]
    Dim v As Variant

    For Each v In c
        a.Add(c.Key)
    Next
    Return a

End

'' The state of a target, as JSON (ABSENT if it doesn't exist)
Public Function Snapshot(sTarget As String) As Variant

    Dim p As Project = sumi.Project
    Dim b As PriceBook = p.Prices
    Dim sId As String
    Dim c As Collection
    Dim a As Variant[]
    Dim h As LaborCharge

    If sTarget Begins "resource:" Then
        sId = Mid$(sTarget, 10)
        If Not b.Resources.Exist(sId) Then Return ABSENT
        Return b.Resources[sId].ToJson()
    Else If sTarget Begins "analysis:" Then
        sId = Mid$(sTarget, 10)
        If Not b.Analyses.Exist(sId) Then Return ABSENT
        Return b.Analyses[sId].ToJson()
    Endif
    If sTarget Begins "contractor:" Then
        Company.EnsureLoaded()
        sId = Mid$(sTarget, 12)
        If Not Company.Contractors.Exist(sId) Then Return ABSENT
        Return Company.Contractors[sId].ToJson()
    Endif
    Select Case sTarget
        Case "standard"
            Company.EnsureLoaded()
            If Not Company.Standard Then Return ABSENT
            Return Company.Standard.ToJson()
        Case "contracts"
            Return p.Contracts.ToJson()
        Case "budget"
            Return p.Budget.ToJson()
        Case "schedule"
            Return p.Schedule.ToJson()
        Case "project"
            c = p.ToJson()
            c.Remove("prices")
            c.Remove("budget")
            c.Remove("schedule")
            c.Remove("contracts")
            c.Remove("changes")
            c.Remove("modified")
            Return c
        Case "book"
            Return ["updateCoef": b.UpdateCoef, "freightPerKm": b.FreightPerKm, "source": b.Source]
        Case "rubros"
            Return b.RubrosJson()
        Case "charges"
            a = New Variant[]
            For Each h In b.Charges
                a.Add(h.ToJson())
            Next
            Return a
        Case "prices"
            Return b.ToJson()
    End Select
    Return ABSENT

End

'' Puts a target back as a snapshot says
Public Sub Restore(sTarget As String, v As Variant)

    Dim p As Project = sumi.Project
    Dim b As PriceBook = p.Prices
    Dim sId As String
    Dim c As Collection
    Dim w As Variant
    Dim r As Resource
    Dim a As Analysis

    If sTarget Begins "resource:" Then
        sId = Mid$(sTarget, 10)
        If IsAbsent(v) Then
            If b.Resources.Exist(sId) Then b.Resources.Remove(sId)
        Else
            r = Resource.FromJson(v)
            b.Resources[sId] = r
        Endif
        Return
    Else If sTarget Begins "analysis:" Then
        sId = Mid$(sTarget, 10)
        If IsAbsent(v) Then
            If b.Analyses.Exist(sId) Then b.Analyses.Remove(sId)
        Else
            a = Analysis.FromJson(v)
            b.Analyses[sId] = a
        Endif
        Return
    Endif
    If sTarget Begins "contractor:" Then
        sId = Mid$(sTarget, 12)
        If IsAbsent(v) Then
            If Company.Contractors.Exist(sId) Then Company.Contractors.Remove(sId)
        Else
            Company.Contractors[sId] = Contractor.FromJson(v)
        Endif
        Return
    Endif
    Select Case sTarget
        Case "standard"
            If IsAbsent(v) Then
                Company.Standard = Null
            Else
                Company.Standard = New PriceBook
                Company.Standard.FromJson(v)
            Endif
        Case "contracts"
            p.Contracts = New Contracts
            p.Contracts.FromJson(v)
        Case "budget"
            p.Budget = New Budget
            p.Budget.FromJson(v)
        Case "schedule"
            p.Schedule = New Schedule
            p.Schedule.FromJson(v)
        Case "project"
            p.FromJson(v)
        Case "book"
            c = v
            b.UpdateCoef = c["updateCoef"]
            b.FreightPerKm = c["freightPerKm"]
            b.Source = c["source"]
        Case "rubros"
            b.Rubros.Clear
            For Each w In v
                If w["name"] Then b.Rubros[CStr(w["number"])] = w["name"]
            Next
        Case "charges"
            b.Charges.Clear
            For Each w In v
                b.Charges.Add(LaborCharge.FromJson(w))
            Next
        Case "prices"
            p.Prices = New PriceBook
            p.Prices.FromJson(v)
    End Select

End

Private Function IsAbsent(v As Variant) As Boolean

    If TypeOf(v) = gb.String And If v = ABSENT Then Return True
    Return IsNull(v)

End

Private Function SameSnapshot(v1 As Variant, v2 As Variant) As Boolean

    Return JSON.Encode(v1) = JSON.Encode(v2)

End

'' Undo the caller's last action; or (bRedo) undo the caller's last undo, if nothing of theirs came after it.
'' The project's log and the company's are searched, and the newest wins.
Private Function Undo(bRedo As Boolean) As Collection

    Dim hProject, hCompany As Change

    Company.EnsureLoaded()
    hProject = FindUndo(sumi.Project.Changes, bRedo)
    hCompany = FindUndo(Company.Changes, bRedo)
    If hCompany Then
        If Not hProject Then Return UndoIn(Company.Changes, hCompany, bRedo, True)
        If hCompany.Id > hProject.Id Then Return UndoIn(Company.Changes, hCompany, bRedo, True)     ' ids sort by creation
    Endif
    If hProject Then Return UndoIn(sumi.Project.Changes, hProject, bRedo, False)
    Return Fail(IIf(bRedo, ("Nothing to redo."), ("Nothing to undo.")))

End

'' The caller's change to undo in a log (redo: their last undo still in force, if it is their last change)
Private Function FindUndo(aChanges As Change[], bRedo As Boolean) As Change

    Dim i As Integer
    Dim h As Change
    Dim sMe As String = Who.UserId()

    For i = aChanges.Max DownTo 0
        h = aChanges[i]
        If h.UserId <> sMe Then Continue
        If bRedo Then
            If h.Command = "undo" And If Not h.UndoneBy Then Return h
            Return Null
        Endif
        If h.UndoneBy Or If h.Command = "undo" Or If h.Command = "redo" Then Continue
        Return h
    Next

End

Private Function UndoIn(aChanges As Change[], hFound As Change, bRedo As Boolean, bCompany As Boolean) As Collection

    Dim i As Integer
    Dim h As Change
    Dim aGroup As New Change[]
    Dim sTarget As String
    Dim hNew As Change

    ' its whole group, newest first
    If hFound.Group Then
        For i = aChanges.Max DownTo 0
            If aChanges[i].Group = hFound.Group And If Not aChanges[i].UndoneBy And If aChanges[i].Command <> "undo" Then aGroup.Add(aChanges[i])
        Next
    Else
        aGroup.Add(hFound)
    Endif

    ' nobody changed those things since (where the after is known)
    For Each h In aGroup
        For Each sTarget In h.Targets
            If Not h.After.Exist(sTarget) Then Continue
            If Not SameSnapshot(Snapshot(sTarget), h.After[sTarget]) Then Return Fail(Subst(("&1 changed after that (&2): it can't be undone without losing that work."), sTarget, LastChangeOf(aChanges, sTarget, h)))
        Next
    Next

    hNew = New Change
    hNew.Who = Who.Name()
    hNew.UserId = Who.UserId()
    hNew.Via = Who.Via
    hNew.Model = Who.Model
    hNew.Command = IIf(bRedo, "redo", "undo")
    hNew.Params = New Collection
    hNew.UndoOf = hFound.Id
    If bRedo Then
        hNew.Summary = ("Redo: ") & Mid$(hFound.Summary, Len(("Undo: ")) + 1)
    Else
        hNew.Summary = ("Undo: ") & hFound.Summary
    Endif
    For Each h In aGroup
        For Each sTarget In h.Targets
            If Not hNew.Targets.Exist(sTarget) Then
                hNew.Targets.Add(sTarget)
                hNew.Before[sTarget] = Snapshot(sTarget)
            Endif
            Restore(sTarget, h.Before[sTarget])
        Next
    Next
    ' a redo makes the undone changes count again
    If bRedo Then
        For Each h In aChanges
            If h.UndoneBy = hFound.Id Then h.UndoneBy = ""
        Next
    Endif
    For Each h In aGroup
        h.UndoneBy = hNew.Id
    Next
    For Each sTarget In hNew.Targets
        If sTarget <> "prices" Then hNew.After[sTarget] = Snapshot(sTarget)
    Next
    aChanges.Add(hNew)
    If bCompany Then
        Company.Save()
        If sumi.Interactive Then fMain.DataChanged()
    Else
        sumi.Changed()
    Endif
    Return Ok(["summary": hNew.Summary])

End

'' Who changed a target after change h
Private Function LastChangeOf(aChanges As Change[], sTarget As String, hAfter As Change) As String

    Dim i As Integer
    Dim h As Change

    For i = aChanges.Max DownTo 0
        h = aChanges[i]
        If h = hAfter Then Break
        If h.Targets.Exist(sTarget) Then Return h.Who & ", " & h.When
    Next
    Return "?"

End

Private Function LogList(c As Collection) As Collection

    Dim aOut As New Variant[]
    Dim i As Integer
    Dim h As Change
    Dim iLimit As Integer = 50

    If c.Exist("limit") Then iLimit = c["limit"]
    For i = sumi.Project.Changes.Max DownTo 0
        h = sumi.Project.Changes[i]
        If c.Exist("who") And If InStr(h.Who, c["who"], 1, gb.IgnoreCase) = 0 Then Continue
        If c.Exist("target") And If Not h.Targets.Exist(c["target"]) Then Continue
        aOut.Add(["id": h.Id, "when": h.When, "who": h.Who, "via": h.Via & IIf(h.Model, " " & h.Model, ""), "summary": h.Summary, "undone": h.UndoneBy <> ""])
        If aOut.Count >= iLimit Then Break
    Next
    Return Ok(["changes": aOut])

End

'' INFO

Private Function Info() As Collection

    Dim p As Project = sumi.Project

    Return Ok(["name": p.Name, "client": p.Client, "location": p.Location, "file": p.FileName, "currency": p.Currency, "startDate": Format(p.StartDate, "yyyy-mm-dd"), "endDate": Format(p.EndDate(), "yyyy-mm-dd"), "priceFactor": p.PriceFactor(), "updateCoef": p.Prices.UpdateCoef, "resources": p.Prices.Resources.Count, "analyses": p.Prices.Analyses.Count, "rubros": p.Prices.Rubros.Count, "budgetItems": p.Budget.Items.Count, "budgetPrice": p.Budget.Totals()[1], "changes": p.Changes.Count, "you": Who.Name(), "via": Who.Via])

End

'' THE PROJECT

Private Function ProjectSet(c As Collection) As Collection

    Dim aAllowed As String[]
    Dim cSet As New Collection
    Dim v As Variant
    Dim sKey As String

    aAllowed = KeysOf(sumi.Project.ToJson())
    For Each sKey In ["prices", "budget", "schedule", "contracts", "created", "modified", "changes"]
        If aAllowed.Exist(sKey) Then aAllowed.Remove(aAllowed.Find(sKey))
    Next
    For Each v In c
        If Not aAllowed.Exist(c.Key) Then Return Fail(Subst(("The project has no field &1."), c.Key))
        cSet[c.Key] = v
    Next
    If cSet.Count = 0 Then Return Fail(("Nothing to set."))
    Start("project.set", c, ("Project: ") & KeysOf(cSet).Join(", "))
    Touch("project")
    sumi.Project.FromJson(cSet)
    Return Ok()

End

'' THE PRICE BOOK

Private Function BookSet(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim sKey As String

    If c.Count = 0 Then Return Fail(("Nothing to set."))
    For Each sKey In KeysOf(c)
        If Not ["updateCoef", "freightPerKm"].Exist(sKey) Then Return Fail(Subst(("The price book has no field &1."), sKey))
    Next
    Start("book.set", c, ("Price coefficients: ") & KeysOf(c).Join(", "))
    Touch("book")
    If c.Exist("updateCoef") Then b.UpdateCoef = c["updateCoef"]
    If c.Exist("freightPerKm") Then b.FreightPerKm = c["freightPerKm"]
    Return Ok()

End

Private Function RubroSet(c As Collection) As Collection

    Dim iNumber As Integer

    If Not c.Exist("number") Or If Not c["name"] Then Return Fail(("rubro.set needs a number and a name."))
    iNumber = c["number"]
    If iNumber <= 0 Then Return Fail(("A rubro number is 1 or more."))
    Start("rubro.set", c, Subst(("Rubro &1: &2"), iNumber, c["name"]))
    Touch("rubros")
    sumi.Project.Prices.Rubros[CStr(iNumber)] = c["name"]
    Return Ok()

End

Private Function RubroDelete(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim a As Analysis
    Dim n As Integer

    If Not b.Rubros.Exist(CStr(c["number"])) Then Return Fail(Subst(("There is no rubro &1."), c["number"]))
    For Each a In b.Analyses
        If a.Rubro = c["number"] Then Inc n
    Next
    If n And If Not c["force"] Then Return Fail(Subst(("&1 analyses are in rubro &2."), n, c["number"]))
    Start("rubro.delete", c, Subst(("Rubro &1 deleted"), c["number"]))
    Touch("rubros")
    b.Rubros.Remove(CStr(c["number"]))
    Return Ok()

End

Private Function ChargeCmd(sCommand As String, c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim h As LaborCharge
    Dim i As Integer = -1

    If sCommand <> "charge.add" Then
        If Not c.Exist("index") Then Return Fail(("It needs the index of the charge."))
        i = c["index"]
        If i < 0 Or If i > b.Charges.Max Then Return Fail(Subst(("There is no charge &1."), i))
    Endif
    Select Case sCommand
        Case "charge.add"
            Start(sCommand, c, Subst(("Labor charge added: &1"), c["name"]))
            Touch("charges")
            h = New LaborCharge
            b.Charges.Add(h)
        Case "charge.set"
            Start(sCommand, c, Subst(("Labor charge &1 changed"), b.Charges[i].Name))
            Touch("charges")
            h = b.Charges[i]
        Case "charge.delete"
            Start(sCommand, c, Subst(("Labor charge deleted: &1"), b.Charges[i].Name))
            Touch("charges")
            b.Charges.Remove(i)
            Return Ok()
    End Select
    If c.Exist("name") Then h.Name = c["name"]
    If c.Exist("pct") Then h.Pct = c["pct"]
    If c.Exist("amount") Then h.Amount = c["amount"]
    If c.Exist("hours") Then h.Hours = c["hours"]
    Return Ok()

End

'' RESOURCES

Private Function FindRes(c As Collection) As Resource

    If Not c["key"] Then Return Null
    Return sumi.Project.Prices.FindResource(CStr(c["key"]))

End

Public Function DescribeResource(r As Resource) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim c As Collection = r.ToJson()

    c["unitPrice"] = b.PriceOf(r)
    c["basePrice"] = b.BasePrice(r)
    If r.HasCalculation() Then c["calculated"] = b.CalculatedPrice(r)
    If b.Freight(r) Then c["freight"] = b.Freight(r)
    Return c

End

Private Function ResourceList(c As Collection) As Collection

    Dim aOut As New Variant[]
    Dim r As Resource
    Dim o As Object
    Dim iLimit As Integer = 1000000
    Dim b As PriceBook = sumi.Project.Prices

    If c.Exist("limit") Then iLimit = c["limit"]
    For Each o In PriceBook.SortedByCode(b.Resources)
        r = o
        If c["kind"] And If r.Kind <> c["kind"] Then Continue
        If c["text"] And If InStr(r.Code & " " & r.Name, c["text"], 1, gb.IgnoreCase) = 0 Then Continue
        aOut.Add(["id": r.Id, "code": r.Code, "name": r.Name, "unit": r.Unit, "kind": r.Kind, "unitPrice": b.PriceOf(r)])
        If aOut.Count >= iLimit Then Break
    Next
    Return Ok(["resources": aOut])

End

Private Function ResourceGet(c As Collection) As Collection

    Dim r As Resource = FindRes(c)
    Dim cOut As Collection
    Dim aUsed As New String[]
    Dim a As Analysis

    If Not r Then Return Fail(Subst(("There is no resource &1."), c["key"]))
    cOut = DescribeResource(r)
    For Each a In sumi.Project.Prices.UsedBy(r.Id, False)
        aUsed.Add(a.Code)
    Next
    cOut["usedBy"] = aUsed
    Return Ok(["resource": cOut])

End

Private Function ResourceAdd(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim r As New Resource
    Dim sBad As String
    Dim cSet As New Collection
    Dim v As Variant

    If c["kind"] And If Not Resource.Kinds().Exist(c["kind"]) Then Return Fail(Subst(("Unknown kind &1: material, labor or equipment."), c["kind"]))
    If Not Trim(c["name"]) Then Return Fail(("A resource needs a name."))
    If c["code"] And If b.ResourceByCode(CStr(c["code"])) Then Return Fail(Subst(("There is already a resource &1."), c["code"]))
    For Each v In c
        If c.Key <> "id" Then cSet[c.Key] = v
    Next
    If c["kind"] Then r.Kind = c["kind"]
    sBad = r.Apply(cSet)
    If sBad Then Return Fail(Subst(("Resources have no field &1."), sBad))
    If Not r.Code Then r.Code = b.NextResourceCode(r.Kind)
    If Not r.Updated And If c.Exist("price") Then r.Updated = Format(Now, "yyyy-mm-dd")
    Start("resource.add", c, Subst(("Resource added: &1 &2"), r.Code, r.Name))
    Touch("resource:" & r.Id)
    b.Resources[r.Id] = r
    Return Ok(["id": r.Id, "code": r.Code])

End

Private Function ResourceSet(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim r As Resource = FindRes(c)
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim hTest As Resource

    If Not r Then Return Fail(Subst(("There is no resource &1."), c["key"]))
    For Each v In c
        If c.Key <> "key" Then cSet[c.Key] = v
    Next
    If cSet.Count = 0 Then Return Fail(("Nothing to set."))
    If cSet.Exist("code") And If CStr(cSet["code"]) <> r.Code And If b.ResourceByCode(CStr(cSet["code"])) Then Return Fail(Subst(("There is already a resource &1."), cSet["code"]))
    If cSet.Exist("code") And If Not Trim(CStr(cSet["code"])) Then Return Fail(("A code can't be empty."))
    ' try it on a copy first: a bad field changes nothing
    hTest = Resource.FromJson(r.ToJson())
    sBad = hTest.Apply(cSet)
    If sBad Then Return Fail(Subst(("Resources have no field &1 (or a bad value)."), sBad))
    Start("resource.set", c, Subst(("Resource &1: &2"), r.Code, KeysOf(cSet).Join(", ")))
    Touch("resource:" & r.Id)
    r.Apply(cSet)
    If cSet.Exist("price") And If Not cSet.Exist("updated") Then r.Updated = Format(Now, "yyyy-mm-dd")
    Return Ok()

End

Private Function ResourceDelete(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim r As Resource = FindRes(c)
    Dim aUsed As Analysis[]

    If Not r Then Return Fail(Subst(("There is no resource &1."), c["key"]))
    aUsed = b.UsedBy(r.Id, False)
    If aUsed.Count And If Not c["force"] Then Return Fail(Subst(("&1 analyses use &2 (the first: &3)."), aUsed.Count, r.Code, aUsed[0].Code))
    Start("resource.delete", c, Subst(("Resource deleted: &1 &2"), r.Code, r.Name))
    Touch("resource:" & r.Id)
    b.Resources.Remove(r.Id)
    Return Ok()

End

'' ANALYSES

Private Function FindAna(c As Collection) As Analysis

    If Not c["key"] Then Return Null
    Return sumi.Project.Prices.FindAnalysis(CStr(c["key"]))

End

Public Function DescribeAnalysis(a As Analysis) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim c As Collection = a.ToJson()
    Dim f As Float[] = b.Parts(a)
    Dim aLines As New Variant[]
    Dim l As AnalysisLine
    Dim cLine As Collection
    Dim i As Integer

    For i = 0 To a.Lines.Max
        l = a.Lines[i]
        cLine = ["index": i, "qty": l.Quantity, "cost": b.LineCost(a, l)]
        If l.IsAnalysis Then
            cLine["analysis"] = l.Ref
            If b.Analyses.Exist(l.Ref) Then
                cLine["code"] = b.Analyses[l.Ref].Code
                cLine["name"] = b.Analyses[l.Ref].Name
                cLine["unit"] = b.Analyses[l.Ref].Unit
                cLine["unitPrice"] = b.Direct(b.Analyses[l.Ref])
            Endif
        Else
            cLine["resource"] = l.Ref
            If b.Resources.Exist(l.Ref) Then
                cLine["code"] = b.Resources[l.Ref].Code
                cLine["name"] = b.Resources[l.Ref].Name
                cLine["unit"] = b.Resources[l.Ref].Unit
                cLine["kind"] = b.Resources[l.Ref].Kind
                cLine["unitPrice"] = b.PriceOf(b.Resources[l.Ref])
            Endif
        Endif
        aLines.Add(cLine)
    Next
    c["lines"] = aLines
    c["materials"] = f[0]
    c["equipment"] = f[1]
    c["labor"] = f[2]
    c["direct"] = f[0] + f[1] + f[2]
    c["price"] = (f[0] + f[1] + f[2]) * sumi.Project.PriceFactor()
    c["problems"] = b.Problems(a)
    Return c

End

Private Function AnalysisList(c As Collection) As Collection

    Dim aOut As New Variant[]
    Dim a As Analysis
    Dim o As Object
    Dim iLimit As Integer = 1000000
    Dim b As PriceBook = sumi.Project.Prices
    Dim fFactor As Float = sumi.Project.PriceFactor()
    Dim fDirect As Float

    If c.Exist("limit") Then iLimit = c["limit"]
    For Each o In PriceBook.SortedByCode(b.Analyses)
        a = o
        If c["rubro"] And If a.Rubro <> c["rubro"] Then Continue
        If c["text"] And If InStr(a.Code & " " & a.Name, c["text"], 1, gb.IgnoreCase) = 0 Then Continue
        fDirect = b.Direct(a)
        aOut.Add(["id": a.Id, "code": a.Code, "name": a.Name, "unit": a.Unit, "rubro": a.Rubro, "direct": fDirect, "price": fDirect * fFactor])
        If aOut.Count >= iLimit Then Break
    Next
    Return Ok(["analyses": aOut])

End

Private Function AnalysisGet(c As Collection) As Collection

    Dim a As Analysis = FindAna(c)
    Dim cOut As Collection
    Dim aUsed As New String[]
    Dim u As Analysis

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    cOut = DescribeAnalysis(a)
    For Each u In sumi.Project.Prices.UsedBy(a.Id, True)
        aUsed.Add(u.Code)
    Next
    cOut["usedBy"] = aUsed
    Return Ok(["analysis": cOut])

End

'' A line from {resource: key, qty} or {analysis: key, qty}; Null and sWhy if it can't be made
Private Function MakeLine(c As Collection, hFor As Analysis, ByRef sWhy As String) As AnalysisLine

    Dim b As PriceBook = sumi.Project.Prices
    Dim r As Resource
    Dim a As Analysis
    Dim fQty As Float

    If c.Exist("qty") Then fQty = c["qty"] Else fQty = 1
    If c["analysis"] Then
        a = b.FindAnalysis(CStr(c["analysis"]))
        If Not a Then
            sWhy = Subst(("There is no analysis &1."), c["analysis"])
            Return Null
        Endif
        If hFor And If b.Contains(a, hFor.Id) Then
            sWhy = Subst(("&1 uses &2: it would be a loop."), a.Code, hFor.Code)
            Return Null
        Endif
        Return AnalysisLine.Make(True, a.Id, fQty)
    Endif
    r = b.FindResource(CStr(c["resource"]))
    If Not r Then
        sWhy = Subst(("There is no resource &1."), c["resource"])
        Return Null
    Endif
    Return AnalysisLine.Make(False, r.Id, fQty)

End

Private Function AnalysisAdd(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim a As New Analysis
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad, sWhy As String
    Dim l As AnalysisLine

    If Not Trim(c["name"]) Then Return Fail(("An analysis needs a name."))
    If c["code"] And If b.AnalysisByCode(CStr(c["code"])) Then Return Fail(Subst(("There is already an analysis &1."), c["code"]))
    For Each v In c
        If c.Key <> "id" And If c.Key <> "lines" Then cSet[c.Key] = v
    Next
    sBad = a.Apply(cSet)
    If sBad Then Return Fail(Subst(("Analyses have no field &1."), sBad))
    If Not a.Code Then a.Code = b.NextAnalysisCode()
    If c.Exist("lines") Then
        For Each v In c["lines"]
            l = MakeLine(v, a, ByRef sWhy)
            If Not l Then Return Fail(sWhy)
            a.Lines.Add(l)
        Next
    Endif
    Start("analysis.add", c, Subst(("Analysis added: &1 &2"), a.Code, a.Name))
    Touch("analysis:" & a.Id)
    b.Analyses[a.Id] = a
    Return Ok(["id": a.Id, "code": a.Code])

End

Private Function AnalysisSet(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim a As Analysis = FindAna(c)
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim hTest As Analysis

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    For Each v In c
        If c.Key <> "key" Then cSet[c.Key] = v
    Next
    If cSet.Count = 0 Then Return Fail(("Nothing to set."))
    If cSet.Exist("lines") Then Return Fail(("Lines change with analysis.addline, setline and removeline."))
    If cSet.Exist("code") And If CStr(cSet["code"]) <> a.Code And If b.AnalysisByCode(CStr(cSet["code"])) Then Return Fail(Subst(("There is already an analysis &1."), cSet["code"]))
    If cSet.Exist("code") And If Not Trim(CStr(cSet["code"])) Then Return Fail(("A code can't be empty."))
    hTest = Analysis.FromJson(a.ToJson())
    sBad = hTest.Apply(cSet)
    If sBad Then Return Fail(Subst(("Analyses have no field &1 (or a bad value)."), sBad))
    Start("analysis.set", c, Subst(("Analysis &1: &2"), a.Code, KeysOf(cSet).Join(", ")))
    Touch("analysis:" & a.Id)
    a.Apply(cSet)
    Return Ok()

End

Private Function AnalysisCopy(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim a As Analysis = FindAna(c)
    Dim n As Analysis
    Dim sCode As String

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    sCode = IIf(c["code"], CStr(c["code"]), b.NextAnalysisCode())
    If b.AnalysisByCode(sCode) Then Return Fail(Subst(("There is already an analysis &1."), sCode))
    n = a.Copy(sCode)
    If c["name"] Then n.Name = c["name"]
    Start("analysis.copy", c, Subst(("Analysis &1 copied as &2"), a.Code, n.Code))
    Touch("analysis:" & n.Id)
    b.Analyses[n.Id] = n
    Return Ok(["id": n.Id, "code": n.Code])

End

Private Function AnalysisDelete(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices
    Dim a As Analysis = FindAna(c)
    Dim aUsed As Analysis[]

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    aUsed = b.UsedBy(a.Id, True)
    If aUsed.Count And If Not c["force"] Then Return Fail(Subst(("&1 analyses use &2 (the first: &3)."), aUsed.Count, a.Code, aUsed[0].Code))
    Start("analysis.delete", c, Subst(("Analysis deleted: &1 &2"), a.Code, a.Name))
    Touch("analysis:" & a.Id)
    b.Analyses.Remove(a.Id)
    Return Ok()

End

Private Function LineCmd(sCommand As String, c As Collection) As Collection

    Dim a As Analysis = FindAna(c)
    Dim l As AnalysisLine
    Dim i As Integer
    Dim sWhy As String

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    If sCommand <> "analysis.addline" Then
        If Not c.Exist("index") Then Return Fail(("It needs the index of the line."))
        i = c["index"]
        If i < 0 Or If i > a.Lines.Max Then Return Fail(Subst(("Analysis &1 has no line &2."), a.Code, i))
    Endif
    Select Case sCommand
        Case "analysis.addline"
            l = MakeLine(c, a, ByRef sWhy)
            If Not l Then Return Fail(sWhy)
            Start(sCommand, c, Subst(("Analysis &1: line added, &2 &3"), a.Code, l.Quantity, sumi.Project.Prices.DescribeRef(l)))
            Touch("analysis:" & a.Id)
            a.Lines.Add(l)
            Return Ok(["index": a.Lines.Max])
        Case "analysis.setline"
            If Not c.Exist("qty") Then Return Fail(("It needs the quantity (qty)."))
            Start(sCommand, c, Subst(("Analysis &1: &2 now &3"), a.Code, sumi.Project.Prices.DescribeRef(a.Lines[i]), c["qty"]))
            Touch("analysis:" & a.Id)
            a.Lines[i].Quantity = c["qty"]
        Case "analysis.removeline"
            Start(sCommand, c, Subst(("Analysis &1: line removed, &2"), a.Code, sumi.Project.Prices.DescribeRef(a.Lines[i])))
            Touch("analysis:" & a.Id)
            a.Lines.Remove(i)
    End Select
    Return Ok()

End

Private Function AnalysisFlatten(c As Collection) As Collection

    Dim a As Analysis = FindAna(c)

    If Not a Then Return Fail(Subst(("There is no analysis &1."), c["key"]))
    Start("analysis.flatten", c, Subst(("Analysis &1 flattened"), a.Code))
    Touch("analysis:" & a.Id)
    sumi.Project.Prices.Flatten(a)
    Return Ok()

End

'' IMPORT

Private Function PricesImport(c As Collection) As Collection

    Dim sFolder As String = c["folder"]

    If Not sFolder Then Return Fail(("It needs the folder of the library."))
    Start("prices.import", c, Subst(("Price library imported: &1"), File.Name(sFolder)))
    Touch("prices")
    If LibraryImport.ImportFolder(sumi.Project.Prices, sFolder, c["added"]) Then
        $hChange = Null
        Return Fail(LibraryImport.Report.Join("\n"))
    Endif
    Return Ok(["report": LibraryImport.Report])

End

'' THE BUDGET

Private Function DescribeItem(b As BudgetItem) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim c As Collection = b.ToJson()

    c["description"] = h.DescriptionOf(b)
    c["unit"] = h.UnitOf(b)
    If b.Analysis And If sumi.Project.Prices.Analyses.Exist(b.Analysis) Then c["analysisCode"] = sumi.Project.Prices.Analyses[b.Analysis].Code
    c["unitDirect"] = h.UnitDirect(b)
    c["unitPrice"] = h.UnitPrice(b)
    c["total"] = h.Total(b)
    If h.Problem(b) Then c["problem"] = h.Problem(b)
    Return c

End

Private Function BudgetList(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim aItems As New Variant[]
    Dim aRubros As New Variant[]
    Dim b As BudgetItem
    Dim iRubro As Integer
    Dim f As Float[]

    For Each b In h.Items
        If c["rubro"] And If b.Rubro <> c["rubro"] Then Continue
        aItems.Add(DescribeItem(b))
    Next
    For Each iRubro In h.UsedRubros()
        f = h.Totals(iRubro)
        aRubros.Add(["rubro": iRubro, "name": sumi.Project.Prices.RubroName(iRubro), "direct": f[0], "price": f[1], "coefs": Coef.ListToJson(h.CoefsOf(iRubro))])
    Next
    f = h.Totals()
    Return Ok(["items": aItems, "rubros": aRubros, "direct": f[0], "price": f[1], "projectFactor": sumi.Project.PriceFactor()])

End

Private Function ItemAdd(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim b As New BudgetItem
    Dim a As Analysis
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String

    If c["analysis"] Then
        a = sumi.Project.Prices.FindAnalysis(CStr(c["analysis"]))
        If Not a Then Return Fail(Subst(("There is no analysis &1."), c["analysis"]))
        b.Analysis = a.Id
        b.Rubro = a.Rubro
    Else If Not Trim(c["description"]) Then
        Return Fail(("An item needs an analysis, or a description (a manual item)."))
    Endif
    For Each v In c
        If c.Key <> "analysis" And If c.Key <> "id" And If c.Key <> "key" Then cSet[c.Key] = v
    Next
    sBad = b.Apply(cSet)
    If sBad Then Return Fail(Subst(("Budget items have no field &1."), sBad))
    Start("item.add", c, Subst(("Budget: item added, &1"), h.DescriptionOf(b)))
    Touch("budget")
    h.Items.Add(b, h.InsertPos(b.Rubro))
    h.Renumber()
    Return Ok(["id": b.Id, "code": b.Code])

End

Private Function ItemSet(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim b As BudgetItem
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim a As Analysis
    Dim hTest As BudgetItem

    If c["key"] Then b = h.Find(CStr(c["key"]))
    If Not b Then Return Fail(Subst(("There is no budget item &1."), c["key"]))
    For Each v In c
        If c.Key <> "key" Then cSet[c.Key] = v
    Next
    If cSet.Count = 0 Then Return Fail(("Nothing to set."))
    If cSet.Exist("analysis") And If cSet["analysis"] Then
        a = sumi.Project.Prices.FindAnalysis(CStr(cSet["analysis"]))
        If Not a Then Return Fail(Subst(("There is no analysis &1."), cSet["analysis"]))
        cSet["analysis"] = a.Id
    Endif
    hTest = BudgetItem.FromJson(b.ToJson())
    sBad = hTest.Apply(cSet)
    If sBad Then Return Fail(Subst(("Budget items have no field &1 (or a bad value)."), sBad))
    Start("item.set", c, Subst(("Budget item &1: &2"), b.Code, KeysOf(cSet).Join(", ")))
    Touch("budget")
    b.Apply(cSet)
    ' a new rubro: it goes to the end of that rubro
    If cSet.Exist("rubro") Then
        h.Items.Remove(h.IndexOf(b.Id))
        h.Items.Add(b, h.InsertPos(b.Rubro))
    Endif
    h.Renumber()
    Return Ok(["code": b.Code])

End

Private Function ItemDelete(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim b As BudgetItem

    If c["key"] Then b = h.Find(CStr(c["key"]))
    If Not b Then Return Fail(Subst(("There is no budget item &1."), c["key"]))
    Start("item.delete", c, Subst(("Budget: item deleted, &1 &2"), b.Code, h.DescriptionOf(b)))
    Touch("budget")
    h.Items.Remove(h.IndexOf(b.Id))
    h.Renumber()
    Return Ok()

End

Private Function ItemMove(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim b As BudgetItem
    Dim i, j As Integer

    If c["key"] Then b = h.Find(CStr(c["key"]))
    If Not b Then Return Fail(Subst(("There is no budget item &1."), c["key"]))
    i = h.IndexOf(b.Id)
    j = i + IIf(c["by"] < 0, -1, 1)
    If j < 0 Or If j > h.Items.Max Or If h.Items[j].Rubro <> b.Rubro Then Return Fail(("It is already at the end of its rubro."))
    Start("item.move", c, Subst(("Budget: item &1 moved"), b.Code))
    Touch("budget")
    h.Items.Remove(i)
    h.Items.Add(b, j)
    h.Renumber()
    Return Ok(["code": b.Code])

End

Private Function RubroCoefs(c As Collection) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim a As Coef[]

    If Not c["rubro"] Then Return Fail(("It needs the rubro number."))
    a = Coef.ListFromJson(c["coefs"])
    Start("rubro.coefs", c, Subst(("Budget: coefficients of rubro &1"), c["rubro"]))
    Touch("budget")
    If a.Count Then
        h.RubroCoefs[CStr(c["rubro"])] = a
    Else If h.RubroCoefs.Exist(CStr(c["rubro"])) Then
        h.RubroCoefs.Remove(CStr(c["rubro"]))
    Endif
    Return Ok()

End

'' THE GANTT

Private Function ScheduleGet(c As Collection) As Collection

    Dim p As Project = sumi.Project
    Dim s As Schedule = p.Schedule
    Dim aTasks As New Variant[]
    Dim b As BudgetItem
    Dim t As GanttTask
    Dim cOut As Collection
    Dim cTask As Collection

    If s.Compute(p.Budget) Then Return Fail(s.Problem)
    For Each b In p.Budget.Items
        t = s.Tasks[b.Id]
        cTask = t.ToJson()
        cTask["code"] = b.Code
        cTask["description"] = p.Budget.DescriptionOf(b)
        cTask["earlyStart"] = t.EarlyStart
        cTask["earlyFinish"] = t.EarlyFinish
        cTask["slack"] = t.Slack()
        cTask["critical"] = t.Critical()
        cTask["start"] = Format(s.DateOf(t.EarlyStart), "yyyy-mm-dd")
        cTask["end"] = Format(s.DateOf(Max(t.EarlyStart, t.EarlyFinish - 1)), "yyyy-mm-dd")
        cTask["laborHoursPerUnit"] = s.LaborHours(b)
        cTask["done"] = s.DoneOf(b)
        aTasks.Add(cTask)
    Next
    cOut = Ok(["tasks": aTasks, "length": s.Length, "end": Format(s.DateOf(Max(0, s.Length - 1)), "yyyy-mm-dd"), "available": p.DurationDays])
    If c["curve"] Then cOut["curve"] = s.Curve(p.Budget)
    Return cOut

End

Private Function TaskSet(c As Collection) As Collection

    Dim p As Project = sumi.Project
    Dim b, o As BudgetItem
    Dim t, hTest As GanttTask
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim aAfter As New String[]

    If c["key"] Then b = p.Budget.Find(CStr(c["key"]))
    If Not b Then Return Fail(Subst(("There is no budget item &1."), c["key"]))
    p.Schedule.Sync(p.Budget)
    t = p.Schedule.Tasks[b.Id]
    For Each v In c
        If c.Key <> "key" And If c.Key <> "suggest" Then cSet[c.Key] = v
    Next
    ' "after" by code or id, checked for loops
    If cSet.Exist("after") Then
        For Each v In cSet["after"]
            o = p.Budget.Find(CStr(v))
            If Not o Then Return Fail(Subst(("There is no budget item &1."), v))
            If o.Id = b.Id Or If p.Schedule.MakesLoop(b.Id, o.Id) Then Return Fail(Subst(("&1 can't wait for &2: it would be a loop."), b.Code, o.Code))
            aAfter.Add(o.Id)
        Next
        cSet["after"] = aAfter
    Endif
    If c["suggest"] Then
        If cSet.Exist("crew") Then v = cSet["crew"] Else v = IIf(t.Crew > 0, t.Crew, 2)
        cSet["crew"] = v
        cSet["days"] = Max(1, Ceil(p.Schedule.SuggestDays(b, v) - 1e-9))
    Endif
    If cSet.Count = 0 Then Return Fail(("Nothing to set."))
    hTest = GanttTask.FromJson(t.ToJson())
    sBad = hTest.Apply(cSet)
    If sBad Then Return Fail(Subst(("Tasks have no field &1 (or a bad value)."), sBad))
    Start("task.set", c, Subst(("Gantt: task &1, &2"), b.Code, KeysOf(cSet).Join(", ")))
    Touch("schedule")
    t.Apply(cSet)
    Return Ok(["days": t.Days])

End

'' THE COMPANY: CONTRACTORS AND THE STANDARD LIBRARY

Private Function DescribeContractor(k As Contractor) As Collection

    Dim c As Collection = k.ToJson()
    Dim aDue As New String[]
    Dim d As ContractorDoc

    For Each d In k.DocsDue()
        aDue.Add(d.Kind & " " & d.Expires)
    Next
    c["docsDue"] = aDue
    Return c

End

Private Function ContractorCmd(sCommand As String, c As Collection) As Collection

    Dim k As Contractor
    Dim a As New Variant[]
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim t As Contract

    Company.EnsureLoaded()
    If sCommand = "contractor.list" Then
        For Each k In Company.SortedContractors()
            If c["trade"] And If InStr(k.Trade, c["trade"], 1, gb.IgnoreCase) = 0 Then Continue
            If c["text"] And If InStr(k.Name & " " & k.Trade & " " & k.Contact, c["text"], 1, gb.IgnoreCase) = 0 Then Continue
            a.Add(DescribeContractor(k))
        Next
        Return Ok(["contractors": a])
    Endif
    If sCommand <> "contractor.add" Then
        If c["key"] Then k = Company.FindContractor(CStr(c["key"]))
        If Not k Then Return Fail(Subst(("There is no contractor &1."), c["key"]))
    Endif
    Select Case sCommand
        Case "contractor.get"
            Return Ok(["contractor": DescribeContractor(k)])
        Case "contractor.add"
            If Not Trim(c["name"]) Then Return Fail(("A contractor needs a name."))
            If Company.FindContractor(Trim(c["name"])) Then Return Fail(Subst(("There is already a contractor &1."), c["name"]))
            k = New Contractor
            For Each v In c
                If c.Key <> "id" Then cSet[c.Key] = v
            Next
            sBad = k.Apply(cSet)
            If sBad Then Return Fail(Subst(("Contractors have no field &1."), sBad))
            Start(sCommand, c, Subst(("Contractor added: &1"), k.Name))
            Touch("contractor:" & k.Id)
            Company.Contractors[k.Id] = k
            Return Ok(["id": k.Id])
        Case "contractor.set"
            For Each v In c
                If c.Key <> "key" Then cSet[c.Key] = v
            Next
            If cSet.Count = 0 Then Return Fail(("Nothing to set."))
            sBad = Contractor.FromJson(k.ToJson()).Apply(cSet)
            If sBad Then Return Fail(Subst(("Contractors have no field &1 (or a bad value)."), sBad))
            Start(sCommand, c, Subst(("Contractor &1: &2"), k.Name, KeysOf(cSet).Join(", ")))
            Touch("contractor:" & k.Id)
            k.Apply(cSet)
        Case "contractor.delete"
            For Each t In sumi.Project.Contracts.Items
                If t.Contractor = k.Id Then Return Fail(Subst(("Contract &1 is with &2."), t.Code, k.Name))
            Next
            Start(sCommand, c, Subst(("Contractor deleted: &1"), k.Name))
            Touch("contractor:" & k.Id)
            Company.Contractors.Remove(k.Id)
    End Select
    Return Ok()

End

'' Copies what hFrom has into hTo: resources and analyses by Id (replaced or added), rubros, and the labor charges
Private Sub MergeBook(hFrom As PriceBook, hTo As PriceBook, bCharges As Boolean)

    Dim r As Resource
    Dim a As Analysis
    Dim v As Variant
    Dim h As LaborCharge

    For Each r In hFrom.Resources
        hTo.Resources[r.Id] = Resource.FromJson(r.ToJson())
    Next
    For Each a In hFrom.Analyses
        hTo.Analyses[a.Id] = Analysis.FromJson(a.ToJson())
    Next
    For Each v In hFrom.Rubros
        hTo.Rubros[hFrom.Rubros.Key] = v
    Next
    If bCharges Then
        hTo.Charges.Clear
        For Each h In hFrom.Charges
            hTo.Charges.Add(LaborCharge.FromJson(h.ToJson()))
        Next
    Endif

End

Private Function StandardExport(c As Collection) As Collection

    Dim b As PriceBook = sumi.Project.Prices

    Company.EnsureLoaded()
    Start("standard.export", c, Subst(("Standard library: the prices of &1 exported (&2 resources, &3 analyses)"), sumi.Project.Title(), b.Resources.Count, b.Analyses.Count))
    Touch("standard")
    If Not Company.Standard Then
        Company.Standard = New PriceBook
        Company.Standard.DefaultCharges()
    Endif
    MergeBook(b, Company.Standard, True)
    Company.Standard.UpdateCoef = 1
    Return Ok()

End

Private Function PricesFromStandard(c As Collection) As Collection

    Company.EnsureLoaded()
    If Not Company.Standard Then Return Fail(("The company has no standard library yet (export a project's prices to make it)."))
    Start("prices.fromStandard", c, ("Prices taken from the standard library"))
    Touch("prices")
    MergeBook(Company.Standard, sumi.Project.Prices, True)
    Return Ok()

End

'' CONTRACTS

Private Function FindContract(c As Collection, Optional sField As String = "key") As Contract

    If Not c[sField] Then Return Null
    Return sumi.Project.Contracts.Find(CStr(c[sField]))

End

Private Function ContractorName(sId As String) As String

    Dim k As Contractor = Company.FindContractor(sId)

    If k Then Return k.Name
    Return ("(unknown contractor)")

End

Public Function DescribeContract(t As Contract) As Collection

    Dim h As Budget = sumi.Project.Budget
    Dim c As Collection = t.ToJson()
    Dim a As New Variant[]
    Dim p As ContractPart
    Dim b As BudgetItem
    Dim q As Certificate
    Dim cPart, cCert As Collection
    Dim f As Float[]

    c["contractorName"] = ContractorName(t.Contractor)
    c["amount"] = t.Amount()
    c["progress"] = t.Progress()
    f = t.Balance()
    c["certified"] = f[0]
    c["paid"] = f[1]
    c["balance"] = f[2]
    For Each p In t.Parts
        cPart = p.ToJson()
        b = h.Find(p.Item)
        If b Then
            cPart["code"] = b.Code
            cPart["description"] = h.DescriptionOf(b)
            cPart["unit"] = h.UnitOf(b)
            If b.Quantity Then cPart["pctOfItem"] = p.Quantity / b.Quantity
            cPart["budgetUnitPrice"] = h.UnitPrice(b)
        Else
            cPart["description"] = ("(the budget item is gone)")
        Endif
        cPart["measured"] = t.Measured(p.Id)
        a.Add(cPart)
    Next
    c["parts"] = a
    a = New Variant[]
    For Each q In t.Certs
        cCert = q.ToJson()
        f = t.Numbers(q)
        cCert["work"] = f[0]
        cCert["adjustment"] = f[1]
        cCert["advanceRecovered"] = f[2]
        cCert["retention"] = f[3]
        cCert["net"] = f[4]
        a.Add(cCert)
    Next
    c["certificates"] = a
    Return c

End

Private Function ContractCmd(sCommand As String, c As Collection) As Collection

    Dim p As Project = sumi.Project
    Dim t As Contract
    Dim a As New Variant[]
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim k As Contractor
    Dim f As Float[]

    Company.EnsureLoaded()
    If sCommand = "contract.list" Then
        For Each t In p.Contracts.Items
            f = t.Balance()
            a.Add(["id": t.Id, "code": t.Code, "title": t.Title, "contractor": ContractorName(t.Contractor), "amount": t.Amount(), "progress": t.Progress(), "certified": f[0], "paid": f[1], "balance": f[2]])
        Next
        Return Ok(["contracts": a])
    Endif
    If sCommand <> "contract.add" Then
        t = FindContract(c)
        If Not t Then Return Fail(Subst(("There is no contract &1."), c["key"]))
    Endif
    For Each v In c
        If c.Key <> "key" And If c.Key <> "id" Then cSet[c.Key] = v
    Next
    If cSet.Exist("contractor") Then
        k = Company.FindContractor(CStr(cSet["contractor"]))
        If Not k Then Return Fail(Subst(("There is no contractor &1."), cSet["contractor"]))
        cSet["contractor"] = k.Id
    Endif
    Select Case sCommand
        Case "contract.get"
            Return Ok(["contract": DescribeContract(t)])
        Case "contract.add"
            If Not k Then Return Fail(("A contract needs a contractor."))
            If cSet["code"] And If p.Contracts.Find(CStr(cSet["code"])) Then Return Fail(Subst(("There is already a contract &1."), cSet["code"]))
            t = New Contract
            ' the Project tab's conditions
            t.Mode = p.ContractMode
            t.AdvancePct = p.AdvancePct
            t.RetentionPct = p.RetentionPct
            t.Period = p.CertificatePeriod
            t.IndexName = p.AdjustmentIndex
            t.BaseMonth = p.AdjustmentBase
            t.Signed = Format(Now, "yyyy-mm-dd")
            sBad = t.Apply(cSet)
            If sBad Then Return Fail(Subst(("Contracts have no field &1."), sBad))
            If Not t.Code Then t.Code = p.Contracts.NextCode()
            If Not t.Title Then t.Title = k.Trade
            Start(sCommand, c, Subst(("Contract &1 with &2"), t.Code, k.Name))
            Touch("contracts")
            p.Contracts.Items.Add(t)
            Return Ok(["id": t.Id, "code": t.Code])
        Case "contract.set"
            If cSet.Count = 0 Then Return Fail(("Nothing to set."))
            sBad = Contract.FromJson(t.ToJson()).Apply(cSet)
            If sBad Then Return Fail(Subst(("Contracts have no field &1 (or a bad value)."), sBad))
            Start(sCommand, c, Subst(("Contract &1: &2"), t.Code, KeysOf(cSet).Join(", ")))
            Touch("contracts")
            t.Apply(cSet)
        Case "contract.delete"
            Start(sCommand, c, Subst(("Contract deleted: &1 &2"), t.Code, t.Title))
            Touch("contracts")
            p.Contracts.Items.Remove(p.Contracts.Items.Find(t))
    End Select
    Return Ok()

End

'' The quantity from {qty} or {pct} (of fWhole); bBad if neither is right
Private Function QtyFrom(c As Collection, fWhole As Float, ByRef bGiven As Boolean) As Float

    bGiven = True
    If c.Exist("qty") Then Return c["qty"]
    If c.Exist("pct") Then Return fWhole * c["pct"] / 100
    bGiven = False

End

Private Function PartCmd(sCommand As String, c As Collection) As Collection

    Dim p As Project = sumi.Project
    Dim t As Contract = FindContract(c, "contract")
    Dim b As BudgetItem
    Dim r As ContractPart
    Dim bGiven As Boolean
    Dim f As Float

    If Not t Then Return Fail(Subst(("There is no contract &1."), c["contract"]))
    If sCommand = "part.add" Then
        If c["item"] Then b = p.Budget.Find(CStr(c["item"]))
        If Not b Then Return Fail(Subst(("There is no budget item &1."), c["item"]))
        f = QtyFrom(c, b.Quantity, ByRef bGiven)
        If Not bGiven Then f = b.Quantity - p.Contracts.Assigned(b.Id)
        If f <= 0 Then Return Fail(Subst(("Item &1 is already taken by contracts: give the quantity."), b.Code))
        r = New ContractPart
        r.Item = b.Id
        r.Quantity = f
        If c.Exist("unitPrice") Then r.UnitPrice = c["unitPrice"] Else r.UnitPrice = p.Budget.UnitPrice(b)
        Start(sCommand, c, Subst(("Contract &1: item &2 added, &3"), t.Code, b.Code, r.Quantity))
        Touch("contracts")
        t.Parts.Add(r)
        Return Ok(["part": r.Id])
    Endif
    If c["part"] Then r = t.FindPart(CStr(c["part"]))
    If Not r And If c["part"] Then
        b = p.Budget.Find(CStr(c["part"]))
        If b Then r = t.FindPart(b.Id)
    Endif
    If Not r Then Return Fail(Subst(("Contract &1 has no part &2."), t.Code, c["part"]))
    b = p.Budget.Find(r.Item)
    Select Case sCommand
        Case "part.set"
            f = QtyFrom(c, IIf(b, b.Quantity, 0.0), ByRef bGiven)
            If Not bGiven And If Not c.Exist("unitPrice") Then Return Fail(("Nothing to set."))
            Start(sCommand, c, Subst(("Contract &1: part changed"), t.Code))
            Touch("contracts")
            If bGiven Then r.Quantity = f
            If c.Exist("unitPrice") Then r.UnitPrice = c["unitPrice"]
        Case "part.remove"
            If t.Measured(r.Id) > 0 Then Return Fail(("It has certified work: it can't be removed."))
            Start(sCommand, c, Subst(("Contract &1: part removed"), t.Code))
            Touch("contracts")
            t.Parts.Remove(t.Parts.Find(r))
    End Select
    Return Ok()

End

Private Function CertCmd(sCommand As String, c As Collection) As Collection

    Dim t As Contract = FindContract(c, "contract")
    Dim q, h As Certificate
    Dim v As Variant
    Dim r As ContractPart
    Dim b As BudgetItem
    Dim cMeasures As New Collection
    Dim f As Float
    Dim n As Integer

    If Not t Then Return Fail(Subst(("There is no contract &1."), c["contract"]))
    Select Case sCommand
        Case "cert.add"
            q = New Certificate
            If c["kind"] Then
                If Not Certificate.Kinds().Exist(c["kind"]) Then Return Fail(Subst(("Unknown kind of certificate &1."), c["kind"]))
                q.Kind = c["kind"]
            Endif
            For Each h In t.Certs
                n = Max(n, h.Number)
                If q.Kind <> Certificate.PROGRESS And If h.Kind = q.Kind Then Return Fail(Subst(("Contract &1 already has its &2 certificate."), t.Code, Tr(q.Kind)))
            Next
            q.Number = n + 1
            q.Period = IIf(c["period"], c["period"], Format(Now, "yyyy-mm"))
            q.When = IIf(c["date"], c["date"], Format(Now, "yyyy-mm-dd"))
            If c.Exist("index") Then q.Index = c["index"]
            ' a progress certificate starts where the last one ended
            If q.Kind = Certificate.PROGRESS Then
                For Each r In t.Parts
                    f = t.Measured(r.Id)
                    If f Then q.Measures[r.Id] = f
                Next
            Endif
            Start(sCommand, c, Subst(("Contract &1: certificate &2 (&3)"), t.Code, q.Number, Tr(q.Kind)))
            Touch("contracts")
            t.Certs.Add(q)
            Return Ok(["number": q.Number, "id": q.Id])
    End Select

    If c["cert"] Then q = t.FindCert(CStr(c["cert"]))
    If Not q Then Return Fail(Subst(("Contract &1 has no certificate &2."), t.Code, c["cert"]))
    If sCommand = "cert.delete" Then
        If q <> t.Certs[t.Certs.Max] Then Return Fail(("Only the last certificate can be deleted."))
        Start(sCommand, c, Subst(("Contract &1: certificate &2 deleted"), t.Code, q.Number))
        Touch("contracts")
        t.Certs.Remove(t.Certs.Max)
        Return Ok()
    Endif

    ' cert.set: check everything first
    If q.Status = "issued" And If c.Exist("measures") Then Return Fail(Subst(("Certificate &1 is issued: its measures can't change (set it back to draft first)."), q.Number))
    If c.Exist("measures") Then
        For Each v In c["measures"]
            r = t.FindPart(CStr(v["part"]))
            If Not r Then
                b = sumi.Project.Budget.Find(CStr(v["part"]))
                If b Then r = t.FindPart(b.Id)
            Endif
            If Not r Then Return Fail(Subst(("Contract &1 has no part &2."), t.Code, v["part"]))
            If v.Exist("acc") Then
                f = v["acc"]
            Else If v.Exist("pct") Then
                f = r.Quantity * v["pct"] / 100
            Else
                Return Fail(("A measure needs acc (the accumulated quantity) or pct."))
            Endif
            If f < t.Before(q, r.Id) - 1e-9 Then Return Fail(Subst(("The accumulated quantity can't go back (&1 before)."), t.Before(q, r.Id)))
            If f > r.Quantity * 1.0000001 Then Return Fail(Subst(("&1 is more than the contract's &2."), f, r.Quantity))
            cMeasures[r.Id] = f
        Next
    Endif
    If c["status"] And If c["status"] <> "draft" And If c["status"] <> "issued" Then Return Fail(("The status is draft or issued."))
    Start(sCommand, c, Subst(("Contract &1: certificate &2 changed"), t.Code, q.Number))
    Touch("contracts")
    For Each v In cMeasures
        q.Measures[cMeasures.Key] = v
    Next
    If c.Exist("period") Then q.Period = c["period"]
    If c.Exist("date") Then q.When = c["date"]
    If c.Exist("index") Then q.Index = c["index"]
    If c.Exist("status") Then q.Status = c["status"]
    If c.Exist("note") Then q.Note = c["note"]
    Return Ok(["net": t.Numbers(q)[4]])

End

Private Function PaymentCmd(sCommand As String, c As Collection) As Collection

    Dim t As Contract = FindContract(c, "contract")
    Dim y As Payment
    Dim cSet As New Collection
    Dim v As Variant
    Dim sBad As String
    Dim q As Certificate
    Dim i As Integer

    If Not t Then Return Fail(Subst(("There is no contract &1."), c["contract"]))
    For Each v In c
        If c.Key <> "contract" And If c.Key <> "index" Then cSet[c.Key] = v
    Next
    If cSet.Exist("certificate") And If cSet["certificate"] Then
        q = t.FindCert(CStr(cSet["certificate"]))
        If Not q Then Return Fail(Subst(("Contract &1 has no certificate &2."), t.Code, cSet["certificate"]))
        cSet["certificate"] = q.Id
    Endif
    If sCommand = "payment.add" Then
        If Not c.Exist("amount") Then Return Fail(("A payment needs its amount."))
        y = New Payment
        y.When = Format(Now, "yyyy-mm-dd")
        sBad = y.Apply(cSet)
        If sBad Then Return Fail(Subst(("Payments have no field &1."), sBad))
        Start(sCommand, c, Subst(("Contract &1: payment of &2"), t.Code, Format(y.Amount, "#,##0.00")))
        Touch("contracts")
        t.Payments.Add(y)
        Return Ok(["index": t.Payments.Max])
    Endif
    i = c["index"]
    If i < 0 Or If i > t.Payments.Max Then Return Fail(Subst(("Contract &1 has no payment &2."), t.Code, i))
    If sCommand = "payment.delete" Then
        Start(sCommand, c, Subst(("Contract &1: payment deleted"), t.Code))
        Touch("contracts")
        t.Payments.Remove(i)
        Return Ok()
    Endif
    sBad = Payment.FromJson(t.Payments[i].ToJson()).Apply(cSet)
    If sBad Then Return Fail(Subst(("Payments have no field &1 (or a bad value)."), sBad))
    Start(sCommand, c, Subst(("Contract &1: payment changed"), t.Code))
    Touch("contracts")
    t.Payments[i].Apply(cSet)
    Return Ok()

End

'' REPORTS (nothing changes: not logged)

Private Function ReportPdf(c As Collection) As Collection

    Dim sWhy As String

    If Not c["kind"] Or If Not c["file"] Then Return Fail(("It needs the kind of report and the file."))
    sWhy = Reports.Make(c["kind"], c["file"], c["contract"], CStr(c["cert"]))
    If sWhy Then Return Fail(sWhy)
    Return Ok(["file": c["file"]])

End

'' THE DESIGN (sumi-designer)

Private Function DesignCmd(sCommand As String, c As Collection) As Collection

    Dim cDesign As Collection
    Dim aRows As New Variant[]
    Dim vRow As Variant
    Dim bDesigner As Boolean
    Dim cRow As Collection

    If sCommand = "design.map" Then
        If Not c["key"] Then Return Fail(("It needs the row's key."))
        Start(sCommand, c, Subst(("Design row &1: its analyses"), c["key"]))
        Touch("budget")
        If c["analyses"] And If c["analyses"].Count Then
            sumi.Project.Budget.DesignMap[c["key"]] = c["analyses"]
        Else If sumi.Project.Budget.DesignMap.Exist(c["key"]) Then
            sumi.Project.Budget.DesignMap.Remove(c["key"])
        Endif
        Return Ok()
    Endif
    cDesign = DesignLink.Read(sumi.Project.DesignFile)
    If Not cDesign Then Return Fail(DesignLink.Report.Join(" "))
    If sCommand = "design.rows" Then
        For Each vRow In cDesign["rows"]
            cRow = ["key": vRow["key"], "group": vRow["group"], "item": vRow["item"], "unit": vRow["unit"], "qty": vRow["qty"]]
            cRow["analyses"] = DesignLink.AnalysesOf(cDesign, vRow["key"], ByRef bDesigner)
            cRow["fromDesigner"] = bDesigner
            aRows.Add(cRow)
        Next
        Return Ok(["rows": aRows, "date": cDesign["date"]])
    Endif
    Start(sCommand, c, ("Budget: quantities from the design"))
    Touch("budget")
    DesignLink.Sync(cDesign)
    Return Ok(["report": DesignLink.Report])

End
