' Gambas class file

'' The Project tab (starting.txt, item 0). Left: the work, its location, the client and notes. Right: the schedule
'' (with holidays, they move the end date), the definitions that turn a direct cost into a price, the contract
'' conditions and the professionals. Editing a field changes sumi.Project at once; every field is attached
'' as "Field" (Form_Open) and is read in Field_Change / Field_Click.

Private $p As Project
Private $bFilling As Boolean
Private $bOwn As Boolean                        ' our own command is running

Private Const PRO_COLUMNS As Integer = 5

'' Set up when made (an embedded form opens later, after fMain shows the project)
Public Sub _new()

    Dim s As String
    Dim h As Object

    Icons.Apply(Me)

    ' every field raises its events as "Field" (read in Field_Change / Field_Click)
    For Each h In [txtName, txtCode, cmbWorkType, cmbUsage, txtNotes, txtLocation, txtCity, txtProvince, txtParcel, spPlot, spCovered, spSemi, spFloors, txtClient, txtClientTaxId, txtClientPhone, txtClientEmail, dtStart, spDuration, spWorkDays, spHours, txtCurrency, spOverhead, spProfit, spTaxes, cmbMode, spAdvance, spRetention, cmbPeriod, txtIndex, txtIndexBase, spGuarantee]
        Object.Attach(h, Me, "Field")
    Next

    ' the lists show the choices translated; the project keeps them in English
    For Each s In Project.WorkTypes()
        cmbWorkType.Add(Tr(s))
    Next
    For Each s In Project.Usages()
        cmbUsage.Add(Tr(s))
    Next
    For Each s In Project.ContractModes()
        cmbMode.Add(Tr(s))
    Next
    For Each s In Project.CertificatePeriods()
        cmbPeriod.Add(Tr(s))
    Next

    tvPros.Columns.Count = PRO_COLUMNS
    tvPros.Columns[0].Text = ("Role")
    tvPros.Columns[1].Text = ("Name")
    tvPros.Columns[2].Text = ("Registration")
    tvPros.Columns[3].Text = ("Phone")
    tvPros.Columns[4].Text = ("Email")
    tvPros.Columns[0].Width = Desktop.Scale * 18
    tvPros.Columns[1].Width = Desktop.Scale * 22
    tvPros.Columns[2].Width = Desktop.Scale * 10

    dtHoliday.Value = Date(Year(Now), Month(Now), Day(Now))

End

Public Sub ShowProject(p As Project)

    $p = p
    $bFilling = True

    txtName.Text = p.Name
    txtCode.Text = p.Code
    SetCombo(cmbWorkType, Project.WorkTypes().Find(p.WorkType))
    SetCombo(cmbUsage, Project.Usages().Find(p.Usage))
    txtDesign.Text = p.DesignFile
    txtNotes.Text = p.Notes

    txtLocation.Text = p.Location
    txtCity.Text = p.City
    txtProvince.Text = p.Province
    txtParcel.Text = p.Parcel
    spPlot.Value = p.PlotArea
    spCovered.Value = p.CoveredArea
    spSemi.Value = p.SemiCoveredArea
    spFloors.Value = p.Floors

    txtClient.Text = p.Client
    txtClientTaxId.Text = p.ClientTaxId
    txtClientPhone.Text = p.ClientPhone
    txtClientEmail.Text = p.ClientEmail

    dtStart.Value = p.StartDate
    spDuration.Value = p.DurationDays
    spWorkDays.Value = p.WorkDaysPerWeek
    spHours.Value = p.HoursPerDay

    txtCurrency.Text = p.Currency
    spOverhead.Value = p.OverheadPct
    spProfit.Value = p.ProfitPct
    spTaxes.Value = p.TaxesPct

    SetCombo(cmbMode, Project.ContractModes().Find(p.ContractMode))
    spAdvance.Value = p.AdvancePct
    spRetention.Value = p.RetentionPct
    SetCombo(cmbPeriod, Project.CertificatePeriods().Find(p.CertificatePeriod))
    txtIndex.Text = p.AdjustmentIndex
    txtIndexBase.Text = p.AdjustmentBase
    spGuarantee.Value = p.GuaranteeDays

    $bFilling = False
    FillHolidays()
    FillPros()
    ShowDerived()

End

'' A choice not in the list (a file from elsewhere) leaves the combo empty
Private Sub SetCombo(hCombo As ComboBox, iIndex As Integer)

    If iIndex >= 0 And If iIndex < hCombo.Count Then
        hCombo.Index = iIndex
    Else
        hCombo.Text = ""
    Endif

End

'' What follows from the fields: the end date, the price factor, the dates of the file
Private Sub ShowDerived()

    Dim dEnd As Date = $p.EndDate()

    lblEnd.Text = Subst(("Ends on &1: &2 calendar days, &3 holidays in between"), Format(dEnd, "dddd yyyy-mm-dd"), DateDiff($p.StartDate, dEnd, gb.Day) + 1, HolidaysBetween($p.StartDate, dEnd))
    lblFactor.Text = Subst(("Price = direct cost × &1 (&2 over cost)"), Format($p.PriceFactor(), "0.0000"), Format($p.PriceFactor() - 1, "0.00%"))
    lblDates.Text = Subst(("Created &1, modified &2"), Format($p.Created, "yyyy-mm-dd hh:nn"), Format($p.Modified, "yyyy-mm-dd hh:nn"))

End

Private Function HolidaysBetween(d1 As Date, d2 As Date) As Integer

    Dim d As Date
    Dim n As Integer

    For Each d In $p.Holidays
        If d >= d1 And If d <= d2 Then Inc n
    Next
    Return n

End

'' Text boxes, spin boxes and dates: each one is a field of the file, changed through Cmd (logged, undoable)
Public Sub Field_Change()

    Dim v As Variant
    Dim sKey As String

    If $bFilling Or If Not $p Then Return
    Select Case Last.Name
        Case "txtName", "txtCode", "txtNotes", "txtLocation", "txtCity", "txtProvince", "txtParcel", "txtClient", "txtClientTaxId", "txtClientPhone", "txtClientEmail"
            v = Last.Text
        Case "txtCurrency", "txtIndex", "txtIndexBase"
            v = Trim(Last.Text)
        Case "dtStart"
            If Not dtStart.Value Then Return
            v = Format(dtStart.Value, "yyyy-mm-dd")
        Case Else
            v = Last.Value
    End Select
    sKey = FieldKey(Last.Name)
    If Not sKey Then Return
    Run(sKey, v)

End

'' The file's name of a field
Private Function FieldKey(sControl As String) As String

    Dim i As Integer = ["txtName", "txtCode", "txtNotes", "txtLocation", "txtCity", "txtProvince", "txtParcel", "spPlot", "spCovered", "spSemi", "spFloors", "txtClient", "txtClientTaxId", "txtClientPhone", "txtClientEmail", "dtStart", "spDuration", "spWorkDays", "spHours", "txtCurrency", "spOverhead", "spProfit", "spTaxes", "spAdvance", "spRetention", "txtIndex", "txtIndexBase", "spGuarantee"].Find(sControl)

    If i < 0 Then Return ""
    Return ["name", "code", "notes", "location", "city", "province", "parcel", "plotArea", "coveredArea", "semiCoveredArea", "floors", "client", "clientTaxId", "clientPhone", "clientEmail", "startDate", "durationDays", "workDaysPerWeek", "hoursPerDay", "currency", "overheadPct", "profitPct", "taxesPct", "advancePct", "retentionPct", "adjustmentIndex", "adjustmentBase", "guaranteeDays"][i]

End

'' Sets one field of the project through Cmd, as our own edit (the box being typed in is not refilled)
Private Sub Run(sKey As String, v As Variant)

    Dim c As New Collection
    Dim cOut As Collection

    c[sKey] = v
    $bOwn = True
    cOut = Cmd.Run("project.set", c)
    $bOwn = False
    If Ui.Failed(cOut) Then ShowProject(sumi.Project)
    ShowDerived()

End

'' After a change made elsewhere (an undo, the AI): show the project again; our own edits are already shown
Public Sub Reload()

    If $bOwn Then Return
    ShowProject(sumi.Project)

End

'' The read-only combo boxes raise Click when a choice is made
Public Sub Field_Click()

    Dim sKey As String
    Dim v As Variant

    If $bFilling Or If Not $p Then Return
    If Not (Last Is ComboBox) Or If Last.Index < 0 Then Return
    Select Case Last.Name
        Case "cmbWorkType"
            sKey = "workType"
            v = Project.WorkTypes()[Last.Index]
        Case "cmbUsage"
            sKey = "use"
            v = Project.Usages()[Last.Index]
        Case "cmbMode"
            sKey = "contractMode"
            v = Project.ContractModes()[Last.Index]
        Case "cmbPeriod"
            sKey = "certificatePeriod"
            v = Project.CertificatePeriods()[Last.Index]
        Case Else
            Return
    End Select
    Run(sKey, v)

End

Public Sub btnBrowse_Click()

    Dialog.Title = ("The sumi-designer project")
    Dialog.Filter = ["*.designer-proj", ("sumi-designer projects"), "*", ("All files")]
    Dialog.Path = IIf($p.DesignFile, $p.DesignFile, IIf(Config.FilesLastPath, Config.FilesLastPath, User.Home) & "/")
    If Dialog.OpenFile() Then Return
    Run("designFile", Dialog.Path)
    txtDesign.Text = $p.DesignFile

End

'' HOLIDAYS

Private Sub FillHolidays()

    Dim d As Date

    lstHolidays.Clear
    For Each d In $p.Holidays
        lstHolidays.Add(Format(d, "dddd yyyy-mm-dd"))
    Next

End

Public Sub btnHolidayAdd_Click()

    If Not dtHoliday.Value Then Return
    If $p.IsHoliday(dtHoliday.Value) Then Return
    Run("holidays", HolidaysWith(dtHoliday.Value, -1))
    FillHolidays()

End

Public Sub btnHolidayRemove_Click()

    If lstHolidays.Index < 0 Then Return
    Run("holidays", HolidaysWith(Null, lstHolidays.Index))
    FillHolidays()

End

'' The holidays as the file has them, with dAdd added or the one at iRemove removed
Private Function HolidaysWith(dAdd As Date, iRemove As Integer) As String[]

    Dim a As New String[]
    Dim i As Integer

    For i = 0 To $p.Holidays.Max
        If i <> iRemove Then a.Add(Format($p.Holidays[i], "yyyy-mm-dd"))
    Next
    If dAdd Then a.Add(Format(dAdd, "yyyy-mm-dd"))
    Return a.Sort()

End

'' The professionals as the file has them, with one row changed, added or removed
Private Function ProsJson(Optional iSkip As Integer = -1) As Variant[]

    Dim a As New Variant[]
    Dim i As Integer

    For i = 0 To $p.Professionals.Max
        If i <> iSkip Then a.Add($p.Professionals[i].ToJson())
    Next
    Return a

End

'' PROFESSIONALS: a click on a cell edits it

Private Sub FillPros()

    Dim i, j As Integer

    tvPros.Rows.Count = $p.Professionals.Count
    For i = 0 To $p.Professionals.Max
        For j = 0 To PRO_COLUMNS - 1
            tvPros[i, j].Text = $p.Professionals[i].GetField(j)
        Next
    Next

End

Public Sub tvPros_Click()

    If tvPros.Row < 0 Or If tvPros.Column < 0 Then Return
    tvPros.Edit()

End

Public Sub tvPros_Save(Row As Integer, Column As Integer, Value As String)

    Dim a As Variant[]

    If Row < 0 Or If Row > $p.Professionals.Max Then Return
    a = ProsJson()
    a[Row][["role", "name", "registration", "phone", "email"][Column]] = Trim(Value)
    Run("professionals", a)
    FillPros()

End

Public Sub btnProAdd_Click()

    Dim a As Variant[] = ProsJson()

    ' the usual roles first, then empty rows
    a.Add(["role": NextRole(), "name": ""])
    Run("professionals", a)
    FillPros()
    tvPros.Row = $p.Professionals.Max
    tvPros.Column = 1

End

Public Sub btnProRemove_Click()

    If tvPros.Row < 0 Or If tvPros.Row > $p.Professionals.Max Then Return
    Run("professionals", ProsJson(tvPros.Row))
    FillPros()

End

'' The first usual role the project doesn't have yet
Private Function NextRole() As String

    Dim sRole As String
    Dim hPro As Professional
    Dim bHas As Boolean

    For Each sRole In [("Design"), ("Structural engineering"), ("Site direction"), ("Builder"), ("Safety and hygiene"), ("Installations")]
        bHas = False
        For Each hPro In $p.Professionals
            If hPro.Role = sRole Then bHas = True
        Next
        If Not bHas Then Return sRole
    Next
    Return ""

End
