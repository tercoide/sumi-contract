# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,150,100)
  Text = ("sumi-contract")
  Icon = Picture["../../.icon.png"]
  Arrangement = Arrange.Fill
  AutoResize = True
  Margin = True
  Padding = 1
  { pnlMayor Panel
    MoveScaled(1,0,146,96)
    Expand = True
    Arrangement = Arrange.Vertical
    { pnlToolbarTop Panel
      MoveScaled(1,0,143,5)
      Arrangement = Arrange.Horizontal
      AutoResize = True
      Spacing = True
      Padding = 1
      Border = Border.Raised
      { tbNew ToolButton
        MoveScaled(0,0,5,5)
        NoTabFocus = True
        ToolTip = ("New")
        Action = "file_new"
      }
      { mbOpen MenuButton
        MoveScaled(5,0,5,5)
        ToolTip = ("Open")
        Action = "file_open"
      }
      { tbSave ToolButton
        MoveScaled(10,0,5,5)
        ToolTip = ("Save")
        Action = "file_save"
      }
      { tbSaveAs ToolButton
        MoveScaled(15,0,5,5)
        ToolTip = ("Save as")
        Action = "file_saveas"
      }
      { Separator1 Separator
        MoveScaled(21,0,1,4)
      }
      { tbUndo ToolButton
        MoveScaled(22,0,5,5)
        ToolTip = ("Undo your last change (Ctrl+Z)")
        Action = "undo"
      }
      { tbRedo ToolButton
        MoveScaled(22,0,5,5)
        ToolTip = ("Redo (Ctrl+Y)")
        Action = "redo"
      }
      { Separator3 Separator
        MoveScaled(28,0,1,4)
      }
      { tbSettings ToolButton
        MoveScaled(23,0,5,5)
        ToolTip = ("Preferences")
        Action = "config"
      }
      { Separator2 Separator
        MoveScaled(29,0,1,4)
      }
      { tbAbout ToolButton
        MoveScaled(31,0,5,5)
        ToolTip = ("About this program")
        Action = "about"
      }
      { Spring1 Spring
        MoveScaled(40,1,3,3)
      }
    }
    { !tabMain TabPanel
      MoveScaled(1,6,143,82)
      #Public = True
      Expand = True
      Arrangement = Arrange.Fill
      Border = False
      Count = 6
      Index = 0
      Text = ("Project")
      Index = 1
      Text = ("Budget")
      Index = 2
      Text = ("Gantt")
      Index = 3
      Text = ("Pricing")
      Index = 4
      Text = ("Contracts")
      Index = 5
      Text = ("History")
      Index = 0
    }
    { StatusBar HBox
      MoveScaled(0,89,143,4)
      Background = &HFF7F9F
      Spacing = True
      { lblStatus Label
        MoveScaled(1,0,60,4)
        Expand = True
        Foreground = Color.ButtonForeground
        Text = ("Ready")
      }
      { lblFile Label
        MoveScaled(90,0,50,4)
        Foreground = Color.ButtonForeground
        Alignment = Align.Right
        AutoResize = True
      }
    }
  }
}

# Gambas Action File 3.0

{ Actions
  { Action about
    Text = "About this program"
    Picture = "$ToolButton"
  }
  { Action config
    Text = "Preferences"
    Picture = "$ToolButton"
  }
  { Action file_new
    Text = "New"
    Picture = "$ToolButton"
  }
  { Action file_open
    Text = "Open"
    Picture = "$MenuButton"
  }
  { Action file_save
    Text = "Save"
    Picture = "$ToolButton"
  }
  { Action file_saveas
    Text = "Save as"
    Picture = "$ToolButton"
  }
  { Action redo
    Text = "Redo (Ctrl+Y)"
    Picture = "$ToolButton"
  }
  { Action undo
    Text = "Undo your last change (Ctrl+Z)"
    Picture = "$ToolButton"
  }
}
