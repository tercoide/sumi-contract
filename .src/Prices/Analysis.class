' Gambas class file

'' A unit price analysis: what one unit of a task takes (materials, equipment hours, labor hours). Its cost is
'' worked out by PriceBook.Parts: materials + equipment / EquipmentYield + labor / LaborYield, as in licita2003's
'' editor (a crew's day priced, divided by the units it makes in a day).

Public Id As String                             '' permanent (see Ids)
Public Code As String = ""                      '' what people see and type; unique in the book
Public Rubro As Integer                         '' the rubro (work category) number
Public Name As String = ""
Public Unit As String = ""
Public LaborYield As Float = 1
Public EquipmentYield As Float = 1
Public Lines As New AnalysisLine[]
Public Note As String = ""

Public Sub _new()

    Id = Ids.Make("a")

End

Public Function ToJson() As Collection

    Dim c As New JSONCollection
    Dim aLines As New Variant[]
    Dim l As AnalysisLine

    c["id"] = Id
    c["code"] = Code
    c["rubro"] = Rubro
    c["name"] = Name
    c["unit"] = Unit
    If LaborYield <> 1 Then c["laborYield"] = LaborYield
    If EquipmentYield <> 1 Then c["equipmentYield"] = EquipmentYield
    For Each l In Lines
        aLines.Add(l.ToJson())
    Next
    c["lines"] = aLines
    If Note Then c["note"] = Note
    Return c

End

Static Public Function FromJson(c As Collection) As Analysis

    Dim a As New Analysis
    Dim v As Variant

    If c["id"] Then a.Id = c["id"]
    a.Apply(c)
    If c.Exist("lines") Then
        For Each v In c["lines"]
            a.Lines.Add(AnalysisLine.FromJson(v))
        Next
    Endif
    Return a

End

'' Sets the fields present in c (the file's names, not the lines). Returns a field it doesn't know, or "".
Public Function Apply(c As Collection) As String

    Dim v As Variant

    For Each v In c
        Select Case c.Key
            Case "id", "lines"
            Case "code"
                Code = CStr(v)
            Case "rubro"
                Rubro = v
            Case "name"
                Name = v
            Case "unit"
                Unit = v
            Case "laborYield"
                LaborYield = v
            Case "equipmentYield"
                EquipmentYield = v
            Case "note"
                Note = v
            Default
                Return c.Key
        End Select
    Next
    Return ""

End

'' A copy with a new Id and another code
Public Function Copy(sCode As String) As Analysis

    Dim a As New Analysis
    Dim l As AnalysisLine

    a.Code = sCode
    a.Rubro = Rubro
    a.Name = Name
    a.Unit = Unit
    a.LaborYield = LaborYield
    a.EquipmentYield = EquipmentYield
    a.Note = Note
    For Each l In Lines
        a.Lines.Add(l.Copy())
    Next
    Return a

End
