' Gambas class file

'' One line of an analysis: a quantity of a resource, or of another analysis (a sub-analysis, kept linked:
'' when it changes, every analysis using it follows). It points by Id, so renaming codes breaks nothing.

Public IsAnalysis As Boolean
Public Ref As String                            '' the Id of the resource or analysis
Public Quantity As Float

Public Function ToJson() As Collection

    Dim c As New JSONCollection

    If IsAnalysis Then c["analysis"] = Ref Else c["resource"] = Ref
    c["qty"] = Quantity
    Return c

End

Static Public Function FromJson(c As Collection) As AnalysisLine

    Dim l As New AnalysisLine

    If c.Exist("analysis") Then
        l.IsAnalysis = True
        l.Ref = c["analysis"]
    Else
        l.Ref = c["resource"]
    Endif
    l.Quantity = c["qty"]
    Return l

End

Public Function Copy() As AnalysisLine

    Dim l As New AnalysisLine

    l.IsAnalysis = IsAnalysis
    l.Ref = Ref
    l.Quantity = Quantity
    Return l

End

Static Public Function Make(bAnalysis As Boolean, sRef As String, fQty As Float) As AnalysisLine

    Dim l As New AnalysisLine

    l.IsAnalysis = bAnalysis
    l.Ref = sRef
    l.Quantity = fQty
    Return l

End
