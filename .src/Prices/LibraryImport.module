' Gambas module file

'' Brings a price library into a PriceBook from CSV files, as Tincho made them from licita2003.xls for s64sketch
'' (~/.config/s64sketch/costs/licita2003):
''   resources.csv       code,name,unit,price,origin,loss,kind          (kind: material, labor, equipment)
''   analyses.csv        code,rubro,name,unit,equipment_yield,labor_yield
''   analysis-items.csv  analysis,resource,quantity
''   rubros.csv          number,name
''   labor.csv           code,category,wage_per_hour,...               (the "mdo" sheet)
''   equipment.csv       number,name,power_hp,cost,residual,life_h,use_h_year,...,fuel,fuel_price,fuel_use,...
'' and, if asked, the "added" folder next to it (the same files, with what was added after the xls).
'' The library's codes become the items' Codes (each gets a new Id); an item whose Code the book already has is
'' updated, nothing is removed.
'' Labor and equipment get their calculation (the wage, the machine); where the library's typed price differs
'' from it, the typed price is kept as an override (what the bids used, often hand edits) and the report lists
'' them. The mdo sheet's category names win over the resources' (decided with the user: 90010 is Sereno).

Public Report As New String[]                   '' what the last import did, for the user

Private $cRes As Collection                     ' code -> Resource of the book being imported into
Private $cAna As Collection                     ' code -> Analysis

'' Imports sFolder (and its sibling "added" when bAdded). Returns True if nothing could be read.
Public Function ImportFolder(hBook As PriceBook, sFolder As String, Optional bAdded As Boolean) As Boolean

    Dim sAdded As String = File.Dir(sFolder) &/ "added"
    Dim r As Resource
    Dim a As Analysis

    Report.Clear
    If Not Exist(sFolder &/ "resources.csv") And If Not Exist(sFolder &/ "analyses.csv") Then
        Report.Add(Subst(("&1 has no resources.csv or analyses.csv."), sFolder))
        Return True
    Endif

    $cRes = New Collection
    For Each r In hBook.Resources
        $cRes[r.Code] = r
    Next
    $cAna = New Collection
    For Each a In hBook.Analyses
        $cAna[a.Code] = a
    Next

    ImportFiles(hBook, sFolder)
    If bAdded And If Exist(sAdded) Then
        Report.Add(("From the added folder:"))
        ImportFiles(hBook, sAdded)
    Endif
    hBook.Source = File.Name(sFolder)
    KeepTypedPrices(hBook)
    ReportMissing(hBook)
    AppLog.Info("Imported price library " & sFolder & ": " & Report.Count & " report lines", "LibraryImport")

End

Private Function GetResource(hBook As PriceBook, sCode As String) As Resource

    Dim r As Resource = $cRes[sCode]

    If Not r Then
        r = New Resource
        r.Code = sCode
        $cRes[sCode] = r
        hBook.Resources[r.Id] = r
    Endif
    Return r

End

Private Sub ImportFiles(hBook As PriceBook, sFolder As String)

    Dim aRows As Collection[]
    Dim c As Collection
    Dim r As Resource
    Dim a As Analysis
    Dim n, nBad As Integer
    Dim sTag As String = File.Name(sFolder)
    Dim cMissing As New Collection
    Dim sCode As String

    ' rubros
    aRows = Csv.Read(sFolder &/ "rubros.csv")
    If aRows Then
        n = 0
        For Each c In aRows
            If ToInt(c["number"]) > 0 And If Trim(c["name"]) Then
                hBook.Rubros[CStr(ToInt(c["number"]))] = Trim(c["name"])
                Inc n
            Endif
        Next
        Report.Add(Subst(("&1 rubros"), n))
    Endif

    ' resources
    aRows = Csv.Read(sFolder &/ "resources.csv")
    If aRows Then
        n = 0
        For Each c In aRows
            sCode = CodeOf(c["code"])
            If Not sCode Then Continue
            r = GetResource(hBook, sCode)
            r.Name = Trim(c["name"])
            r.Unit = Trim(c["unit"])
            If Resource.Kinds().Exist(c["kind"]) Then r.Kind = c["kind"]
            If Trim(c["price"]) Then
                r.Price = ToFloat(c["price"])
                r.Source = sTag
            Endif
            If c.Exist("origin") Then r.Origin = Trim(c["origin"])
            If c.Exist("loss") And If Trim(c["loss"]) Then r.LossPct = ToFloat(c["loss"])
            Inc n
        Next
        Report.Add(Subst(("&1 resources"), n))
    Endif

    ' labor categories (the "mdo" sheet): the wage, the name
    aRows = Csv.Read(sFolder &/ "labor.csv")
    If aRows Then
        n = 0
        For Each c In aRows
            sCode = CodeOf(c["code"])
            If Not sCode Then Continue
            r = GetResource(hBook, sCode)
            r.Kind = Resource.LABOR
            If Not r.Unit Then r.Unit = "h"
            If Trim(c["category"]) And If LCase(Trim(c["category"])) <> LCase(r.Name) Then
                If r.Name Then Report.Add(Subst(("&1: named &2 (it was &3 in the resources)"), sCode, Trim(c["category"]), r.Name))
                r.Name = Trim(c["category"])
            Endif
            r.Wage = ToFloat(c["wage_per_hour"])
            Inc n
        Next
        Report.Add(Subst(("&1 labor categories"), n))
    Endif

    ' equipment (the "equ" sheet): its number n prices resource 100000 + n
    aRows = Csv.Read(sFolder &/ "equipment.csv")
    If aRows Then
        n = 0
        For Each c In aRows
            If ToInt(c["number"]) <= 0 Then Continue
            r = GetResource(hBook, CStr(100000 + ToInt(c["number"])))
            r.Kind = Resource.EQUIPMENT
            If Not r.Name Then r.Name = Trim(c["name"])
            If Not r.Unit Then r.Unit = "h"
            r.MachineCalc = New Machine
            With r.MachineCalc
                .Power = ToFloat(c["power_hp"])
                .Cost = ToFloat(c["cost"])
                If .Cost > 0 Then .ResidualPct = ToFloat(c["residual"]) / .Cost * 100
                If ToFloat(c["life_h"]) > 0 Then .LifeHours = ToFloat(c["life_h"])
                If ToFloat(c["use_h_year"]) > 0 Then .HoursPerYear = ToFloat(c["use_h_year"])
                .Fuel = Trim(c["fuel"])
                .FuelPrice = ToFloat(c["fuel_price"])
                If .Power > 0 Then .FuelUse = ToFloat(c["fuel_use"]) / .Power        ' the csv has liters an hour
            End With
            Inc n
        Next
        Report.Add(Subst(("&1 machines"), n))
    Endif

    ' analyses and their lines
    aRows = Csv.Read(sFolder &/ "analyses.csv")
    If aRows Then
        n = 0
        For Each c In aRows
            sCode = CodeOf(c["code"])
            If Not sCode Then Continue
            a = $cAna[sCode]
            If a Then
                a.Lines.Clear
            Else
                a = New Analysis
                a.Code = sCode
                $cAna[sCode] = a
                hBook.Analyses[a.Id] = a
            Endif
            a.Rubro = ToInt(c["rubro"])
            a.Name = Trim(c["name"])
            a.Unit = Trim(c["unit"])
            a.EquipmentYield = IIf(ToFloat(c["equipment_yield"]) > 0, ToFloat(c["equipment_yield"]), 1)
            a.LaborYield = IIf(ToFloat(c["labor_yield"]) > 0, ToFloat(c["labor_yield"]), 1)
            Inc n
        Next
        Report.Add(Subst(("&1 analyses"), n))
    Endif
    aRows = Csv.Read(sFolder &/ "analysis-items.csv")
    If aRows Then
        n = 0
        nBad = 0
        For Each c In aRows
            a = $cAna[CodeOf(c["analysis"])]
            If Not a Then
                Inc nBad
                Continue
            Endif
            sCode = CodeOf(c["resource"])
            r = $cRes[sCode]
            If Not r Then
                ' a resource the library doesn't have: made empty, so the line is kept and the problem shows
                r = GetResource(hBook, sCode)
                r.Name = ("(missing in the library)")
                cMissing[sCode] = sCode
            Endif
            a.Lines.Add(AnalysisLine.Make(False, r.Id, ToFloat(c["quantity"])))
            Inc n
        Next
        Report.Add(Subst(("&1 analysis lines"), n))
        If nBad Then Report.Add(Subst(("&1 lines of analyses that don't exist were skipped"), nBad))
    Endif

End

'' Labor and equipment whose typed price differs from the calculation keep the typed one as an override
Private Sub KeepTypedPrices(hBook As PriceBook)

    Dim r As Resource
    Dim fCalc As Float
    Dim aLines As New String[]

    For Each r In hBook.Resources
        If r.Kind = Resource.MATERIAL Or If Not r.HasCalculation() Then Continue
        fCalc = hBook.CalculatedPrice(r)
        If r.Price > 0 And If Abs(fCalc - r.Price) > 0.005 Then
            r.PriceOverride = True
            aLines.Add(Subst("&1 &2: &3 / &4", r.Code, r.Name, Format(r.Price, "0.00"), Format(fCalc, "0.00")))
        Else
            r.PriceOverride = False
        Endif
    Next
    If aLines.Count Then
        Report.Add(Subst(("&1 labor and equipment prices were typed over their calculation and are kept as overrides (typed / calculated):"), aLines.Count))
        Report.Insert(aLines)
    Endif

End

'' Resources the analyses use but the library doesn't have, and resources without a price
Private Sub ReportMissing(hBook As PriceBook)

    Dim r As Resource
    Dim aMissing As New String[]
    Dim nNoPrice As Integer

    For Each r In hBook.Resources
        If r.Name = ("(missing in the library)") Then
            aMissing.Add(r.Code)
        Else If hBook.PriceOf(r) = 0 Then
            Inc nNoPrice
        Endif
    Next
    If aMissing.Count Then Report.Add(Subst(("&1 resources used by analyses are missing in the library, made empty: &2"), aMissing.Count, aMissing.Join(", ")))
    If nNoPrice Then Report.Add(Subst(("&1 resources have no price"), nNoPrice))

End

'' A code as written in the CSV ("2001", "2001.0") as text; "" if there is none
Private Function CodeOf(v As Variant) As String

    Dim s As String = Trim(CStr(v))

    If s = "" Or If s = "0" Then Return ""
    If InStr(s, ".") And If Utils.IsDigits(Left(s, InStr(s, ".") - 1)) And If Utils.IsDigits(Replace(Mid(s, InStr(s, ".") + 1), "0", ""), True) Then s = Left(s, InStr(s, ".") - 1)
    Return s

End

'' Numbers as written in the CSV ("1.35"); "" = 0
Public Function ToFloat(v As Variant) As Float

    Dim f As Float

    If IsNull(v) Then Return 0
    Try f = CFloat(Trim(Replace(CStr(v), ",", ".")))
    Return f

End

Public Function ToInt(v As Variant) As Integer

    Return CInt(Round(ToFloat(v)))

End
